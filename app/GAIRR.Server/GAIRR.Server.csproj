<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>gairr-agent-server</AssemblyName>
    <RootNamespace>GAIRR.Server</RootNamespace>
    <Version>0.2.0</Version>
    <Product>gairr-agent-server</Product>
    <Description>GAIRR Agent 接口服务（Kestrel + SSE）：会话/任务级接口，无界面</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\GAIRR.Agent\GAIRR.Agent.csproj" />
  </ItemGroup>

  <!-- 开发便利：配置/技能/插件跟随 GAIRR 壳（存在才复制，发布时以发布目录为准） -->
  <ItemGroup>
    <None Include="..\GAIRR\config.ini" Link="config.ini" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GAIRR\config.ini')" />
    <None Include="..\GAIRR\system.ini" Link="system.ini" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GAIRR\system.ini')" />
    <None Include="..\GAIRR\skills\**" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GAIRR\skills')" />
    <None Include="..\GAIRR\plugins\**" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GAIRR\plugins')" />
    <!-- 工具级提示词（工作模式等，与项目无关）：从 GAIRR 壳 prompts/ 复制到本程序目录，供 AgentLoop.PromptPath 读取 -->
    <None Include="..\GAIRR\prompts\**" Link="prompts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GAIRR\prompts')" />
  </ItemGroup>

</Project>

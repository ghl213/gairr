<Window x:Class="GAIRR.AutoTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑自动任务" Width="1040" Height="960" MinWidth="1040" MinHeight="840"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
        ResizeMode="CanResizeWithGrip" WindowStyle="None"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="DialogPrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource GradP12}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DialogSecondaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1C1D29"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DimBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2B2D3A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题 -->
                <RowDefinition Height="Auto"/>   <!-- 任务名称 label -->
                <RowDefinition Height="Auto"/>   <!-- tbTitle -->
                <RowDefinition Height="Auto"/>   <!-- 执行周期 label -->
                <RowDefinition Height="Auto"/>   <!-- cbType -->
                <RowDefinition Height="Auto"/>   <!-- 小时/分钟/星期/日期 -->
                <RowDefinition Height="*"/>      <!-- 任务提示词（弹性） -->
                <RowDefinition Height="*"/>      <!-- 任务执行步骤提示词（弹性） -->
                <RowDefinition Height="Auto"/>   <!-- 按钮行 -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="编辑自动任务" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" Text="任务名称" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="tbTitle" Grid.Row="2" Background="{StaticResource CardBrush}"
                     BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                     Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                     Padding="10,8" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="3" Text="执行周期" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="cbType" Grid.Row="4" Style="{StaticResource ProjCombo}"
                      FontSize="13" Margin="0,0,0,10" SelectionChanged="OnTypeChanged">
                <ComboBoxItem Content="每天" Style="{StaticResource DarkComboItem}"/>
                <ComboBoxItem Content="工作日" Style="{StaticResource DarkComboItem}"/>
                <ComboBoxItem Content="每周" Style="{StaticResource DarkComboItem}"/>
                <ComboBoxItem Content="每月" Style="{StaticResource DarkComboItem}"/>
                <ComboBoxItem Content="Cron 表达式" Style="{StaticResource DarkComboItem}"/>
            </ComboBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,14">
                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="小时" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="tbHour" Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             Padding="10,8" FontSize="13" Text="17"/>
                </StackPanel>
                <StackPanel Width="120" Margin="0,0,12,0">
                    <TextBlock Text="分钟" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="tbMinute" Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             Padding="10,8" FontSize="13" Text="00"/>
                </StackPanel>
                <StackPanel x:Name="panelWeek" Width="160" Visibility="Collapsed">
                    <TextBlock Text="星期" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbWeekDay" Style="{StaticResource ProjCombo}" FontSize="13">
                        <ComboBoxItem Content="周一" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周二" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周三" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周四" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周五" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周六" Style="{StaticResource DarkComboItem}"/>
                        <ComboBoxItem Content="周日" Style="{StaticResource DarkComboItem}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="panelMonth" Width="120" Visibility="Collapsed">
                    <TextBlock Text="日期" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="tbMonthDay" Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             Padding="10,8" FontSize="13" Text="1"/>
                </StackPanel>
                <StackPanel x:Name="panelCron" Width="320" Visibility="Collapsed">
                    <TextBlock Text="Cron 表达式（分 时 日 月 周）" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="tbCron" Background="{StaticResource CardBrush}"
                             BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             Padding="10,8" FontSize="13" Text="0 9 * * 1-5"/>
                </StackPanel>
                <StackPanel Width="230">
                    <TextBlock Text="工作模式（Flow 模板）" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbFlowMode" Style="{StaticResource ProjCombo}" FontSize="13"
                              ToolTip="自主=模型自行规划；选 Flow 模板则按工具目录 flows/*.json 的步骤序列执行">
                        <ComboBoxItem Content="自主模式" Style="{StaticResource DarkComboItem}"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="任务提示词（任务目标描述，创建/修改时发送给 Agent）"
                           FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="tbPrompt" Grid.Row="1" MinHeight="80"
                         Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                         BorderThickness="1" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         Padding="10,8" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="7" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="任务执行步骤提示词（首次执行成功后自动总结生成，可手动编辑；留空则按任务提示词执行）"
                           FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="tbExecPrompt" Grid.Row="1" MinHeight="80"
                         Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                         BorderThickness="1" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                         Padding="10,8" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </Grid>

            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="80" Height="32" Margin="0,0,10,0" Click="OnCancel"
                        Style="{StaticResource DialogSecondaryBtn}"/>
                <Button Content="保存" Width="80" Height="32" Click="OnSave"
                        Style="{StaticResource DialogPrimaryBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

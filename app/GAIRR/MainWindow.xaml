<Window x:Class="GAIRR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GAIRR"
        xmlns:core="clr-namespace:GAIRR.Core;assembly=GAIRR.Agent"
        xmlns:coreui="clr-namespace:GAIRR.Core"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="GAIRR Agent"
        Width="1100" Height="680" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei, PingFang SC, sans-serif"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="OnWindowClosing"
        PreviewMouseWheel="OnWindowPreviewWheel">

    <!-- 自绘标题栏：WindowChrome 接管非客户区，去掉系统外框/圆角，保留拖拽缩放 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <coreui:MarkdownConverter x:Key="MdConv"/>
        <local:FitWidthConverter x:Key="FitWidth"/>
        <local:BoolToBrushConverter x:Key="BoolToBrush"/>
        <local:AlertLevelToBrushConverter x:Key="AlertToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:LevelLabelConverter x:Key="LevelLabelConv"/>
        <local:HalfWidthConverter x:Key="HalfW"/>
        <local:TreeGuideMarginConverter x:Key="TreeGuideMargin"/>
        <local:TreeGuideVisConverter x:Key="TreeGuideVis"/>
        <!-- GPU 资源三色柱（标题栏本地模型监控）：细圆角条，填充色由 GpuMonitor 按阈值给出 -->
        <Style x:Key="GpuBar" TargetType="ProgressBar">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#26FFFFFF" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色动作按钮（问题卡片“提交答案/补充说明”、编排输入区“生成任务树”/“发送”“停止”等）：内联深色底经 TemplateBinding 透传，
             底色层与悬浮高亮罩同区域同圆角（高亮覆盖整个按钮，不被内边距截出边缝）；悬浮/按下叠半透明白罩提亮、前景转白，
             不落入系统默认模板的浅白底；禁用时整钮降透明 -->
        <Style x:Key="DarkActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <!-- 悬浮/按下高亮罩：与整钮同区域同圆角，叠在底色层之上、内容层之下 -->
                            <Border x:Name="hov" Background="Transparent" CornerRadius="6"/>
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hov" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hov" Property="Background" Value="#46FFFFFF"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自绘标题栏按钮：最小化/最大化 -->
        <Style x:Key="CapBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <!-- 高 30：标题栏 44 高不变，按钮垂直居中后上下各留 7px 边距，与同行 30px 控件对齐（编辑器按钮自带显式 36×36，不受影响） -->
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Microsoft YaHei"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自绘标题栏按钮：关闭（悬停变红） -->
        <Style x:Key="CapCloseBtn" TargetType="Button" BasedOn="{StaticResource CapBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右栏代码查看页签条 ✕ 关闭按钮：悬停/按下底色同标题栏最小化按钮（CapBtn），避免默认模板的高亮闪色 -->
        <Style x:Key="CodeTabCloseBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏分组小标题 -->
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Margin" Value="6,14,0,8"/>
        </Style>

        <!-- 侧栏行内圆点 -->
        <Style x:Key="RowDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 侧栏行右侧小字（等宽） -->
        <Style x:Key="RowSig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- 侧栏列表项悬停提示（多行）：深色底圆角，名称加粗、完整描述自动换行、使用前提灰色小字，最大宽 360 防超长 -->
        <Style x:Key="ItemTip" TargetType="ToolTip">
            <Setter Property="Background" Value="#1E1F2A"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderBrush" Value="#3A3B4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 市场条目卡片（三栏共用）：第一行 标题+元信息+操作按钮，第二行 100% 宽最多 3 行小字摘要 -->
        <DataTemplate x:Key="MarketCard" DataType="{x:Type core:MarketEntryDef}">
            <Border Style="{StaticResource RowBox}" Margin="0,0,0,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- 状态点 + 标题 -->
                            <ColumnDefinition Width="*"/>      <!-- 元信息（可被挤压省略） -->
                            <ColumnDefinition Width="Auto"/>   <!-- 操作按钮（固定宽，永不被挤掉） -->
                        </Grid.ColumnDefinitions>
                        <!-- 名称（蓝色）+ 下方数量行（★星标 / ⬇下载量，无数据时隐藏） -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding Name}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource RowDot}" Fill="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" MaxWidth="200"
                                           Foreground="{StaticResource P2Brush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatText}" FontSize="10.5"
                                       Foreground="{StaticResource CmtBrush}" Margin="13,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStat}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MetaText}" Style="{StaticResource RowSig}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="{Binding ActionText}" Width="56" Height="24"
                                Margin="10,0,0,0" Tag="{Binding EntryKey}"
                                Style="{StaticResource MarketActBtn}"
                                Click="OnMarketAction" IsEnabled="{Binding ActionEnabled}"/>
                    </Grid>
                    <!-- 第二行：100% 宽小字摘要（最多 3 行）：中文翻译优先，未翻译回退英文原文；安装中显示进度、失败显示原因 -->
                    <TextBlock Margin="14,4,0,0" FontSize="11" Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="48">
                        <TextBlock.ToolTip>
                            <ToolTip Style="{StaticResource ItemTip}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding DisplayDescription}" FontSize="11.5" Foreground="#D8D8E8"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Preconditions}" FontSize="10.5" Foreground="#8B90A8"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DisplayDescription}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="installing">
                                        <Setter Property="Text" Value="{Binding ProgressText}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="failed">
                                        <Setter Property="Text" Value="{Binding Error}"/>
                                        <Setter Property="Foreground" Value="#FF8888"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 对话区可选中文字：只读 TextBox 扮成 TextBlock（.NET 8 的 TextBlock 不支持选中） -->
        <Style x:Key="SelText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- 任务卡片深色滑动开关：加大触控区域 -->
        <Style x:Key="DarkSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="#35FFFFFF" BorderBrush="Transparent" BorderThickness="0">
                            <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                    Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4FFFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#5DCC9E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手机端服务开关小号滑动开关（版权行右下角）：比 DarkSwitch 更紧凑，仅此一处使用 -->
        <Style x:Key="DarkSwitchMini" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="34" Height="18" CornerRadius="9"
                                Background="#35FFFFFF" BorderBrush="Transparent" BorderThickness="0">
                            <Border x:Name="Thumb" Width="12" Height="12" CornerRadius="6"
                                    Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4FFFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#5DCC9E"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项深色化 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 工具调用卡片（对应 details/summary 折叠块） ============ -->
        <Style x:Key="ToolDetails" TargetType="Expander">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="IsExpanded" Value="{Binding Open, Mode=OneWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" x:Name="head" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hb" Background="Transparent" Padding="14,9">
                                                <DockPanel>
                                                    <!-- 读文件工具卡“查看”入口（仅 Read 成功且回填了文件路径时显示）：标题行最右侧，
点击在右侧代码查看器打开文件快照并定位读取段 -->
                                                    <Button x:Name="codeViewBtn" DockPanel.Dock="Right" Content="⌕ 查看"
                                                            Click="OnCodeViewClick"
                                                            FontSize="10.5" Padding="7,2" Margin="6,0,0,0" Cursor="Hand"
                                                            BorderThickness="0" Background="#335C8AE6" Foreground="#BBD4FF"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <!-- 自定义模板：悬浮叠白罩提亮底色（前景不变，避免默认系统浅底上亮字看不清） -->
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <Grid>
                                                                                    <Border x:Name="hov" Background="Transparent" CornerRadius="5"/>
                                                                                    <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="hov" Property="Background" Value="#30FFFFFF"/>
                                                                                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="hov" Property="Background" Value="#46FFFFFF"/>
                                                                                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CodeVisible}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock x:Name="statusTxt" DockPanel.Dock="Right" Text="{Binding Status}"
                                                               FontFamily="Consolas" FontSize="11" Margin="10,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                                                <!-- 运行中 Status="…"：隐藏静态占位，由右侧旋转光环代替 -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="…">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- D · 旋转亮弧（光环）：工具执行中（Status="…"）在状态文字位显示，代替静态占位符 -->
                                                    <Grid DockPanel.Dock="Right" Width="16" Height="16" Margin="10,0,0,0"
                                                          VerticalAlignment="Center">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="…">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Ellipse Width="13" Height="13" Stroke="{StaticResource DimBrush}" StrokeThickness="2"/>
                                                        <Ellipse Width="13" Height="13" Stroke="{StaticResource GreenBrush}" StrokeThickness="2"
                                                                 StrokeDashArray="5.1,15.3" StrokeDashCap="Round"
                                                                 RenderTransformOrigin="0.5,0.5">
                                                            <Ellipse.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Ellipse.RenderTransform>
                                                            <Ellipse.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:1.6"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Ellipse.Triggers>
                                                        </Ellipse>
                                                    </Grid>
                                                    <TextBlock x:Name="iconTxt" DockPanel.Dock="Left" Text="{Binding Icon}"
                                                               FontFamily="Segoe UI Emoji" FontSize="{Binding IconFontSize}" Margin="0,0,6,0"
                                                               Foreground="{Binding IconColor}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="titleTxt" DockPanel.Dock="Left" Text="{Binding Header}" Foreground="{StaticResource TextBrush}"
                                                               FontFamily="Consolas" FontSize="12.5" MaxWidth="340"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource DimBrush}"
                                                               FontFamily="Consolas" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hb" Property="Background" Value="#0AFFFFFF"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsStep}" Value="True">
                                                    <Setter TargetName="titleTxt" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                    <Setter TargetName="statusTxt" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border DockPanel.Dock="Top" x:Name="body"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                    <Grid Margin="14,10">
                                        <TextBox x:Name="txtBody" Text="{Binding Inner, Mode=OneWay}" Style="{StaticResource SelText}"
                                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource DimBrush}"/>
                                        <!-- diff 视图：IsDiff=true 时替换纯文本预览，按 DiffLine 逐行红绿渲染 -->
                                        <ItemsControl x:Name="diffBody" ItemsSource="{Binding DiffLines}" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding BgBrush}" CornerRadius="2" Padding="4,1">
                                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                                   Foreground="{Binding FgBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDiff}" Value="True">
                                <Setter TargetName="txtBody" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="diffBody" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 技能面板 Expander 样式（箭头背景透明） ============ -->
        <Style x:Key="SkillExpander" TargetType="Expander">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" x:Name="head" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0"
                                              Content="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hb" Background="Transparent" Padding="10,8">
                                                <DockPanel>
                                                    <Path x:Name="arrow" DockPanel.Dock="Left" Fill="Transparent" Stroke="#8888A0" StrokeThickness="1.5"
                                                          StrokeLineJoin="Round" Data="M 1 0 L 5 4 L 1 8"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      VerticalAlignment="Center"
                                                                      TextBlock.Foreground="{StaticResource TextBrush}"
                                                                      TextBlock.FontSize="12"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hb" Property="Background" Value="#0AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="arrow" Property="Data" Value="M 0 1 L 4 5 L 8 1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border DockPanel.Dock="Top" x:Name="body"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                                        Visibility="Collapsed"
                                        Padding="10,4,10,8">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 窄深色滚动条公共样式（AvalonEdit / FlowDocumentScrollViewer 等局部控件以隐式 BasedOn 引用，Template 才能生效；横向条同样压窄） -->
        <Style x:Key="NarrowScroll" TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <!-- Track 默认 IsDirectionReversed=True 仅对垂直方向正确；水平方向须翻转（WPF Track 坐标系
                                 水平默认值增大向右，IsDirectionReversed=True 会把左/右镜像），与 Theme.xaml NarrowScrollBar 同规则 -->
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="decBtn" Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="incBtn" Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2" Background="#2A2A3A"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 水平滚动条：方向不反转（thumb 左=起点 0），轨道两侧点击对应向左/向右翻页 -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="decBtn" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="incBtn" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 执行过程时间线模板（思考条/工具卡按发生顺序交错排列） ============ -->
        <DataTemplate DataType="{x:Type local:ToolCall}">
            <Expander Style="{StaticResource ToolDetails}">
                <!-- 最小宽与提示条同宽：同一转换器同一参数测 Steps 文本；min 模式空文本回退 0 -->
                <Expander.MinWidth>
                    <Binding Path="DataContext.Steps" RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                             Converter="{StaticResource FitWidth}" ConverterParameter="12.5|Consolas|48|min"/>
                </Expander.MinWidth>
                <Expander.MaxWidth>
                    <MultiBinding Converter="{StaticResource FitWidth}" ConverterParameter="12.5|Consolas|90">
                        <Binding Path="Title"/>
                        <Binding Path="Inner"/>
                    </MultiBinding>
                </Expander.MaxWidth>
            </Expander>
        </DataTemplate>

        <!-- ============ 思考条样式（每轮思考，可折叠；与工具卡同款配色，靠标题文字区分） ============ -->
        <Style x:Key="ThinkingDetails" TargetType="Expander">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="IsExpanded" Value="{Binding Open, Mode=OneWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" ClipToBounds="True">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" x:Name="head" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hb" Background="Transparent" Padding="14,7">
                                                <DockPanel>
                                                    <!-- 思考卡“上下文”入口（仅带轮次归属时显示）：点击在右侧查看器打开本轮请求上下文快照 -->
                                                    <Button DockPanel.Dock="Right" Content="上下文"
                                                            Click="OnThinkCtxClick"
                                                            Visibility="{Binding CtxVisible, Mode=OneWay}"
                                                            FontSize="10.5" Padding="7,2" Margin="6,0,0,0" Cursor="Hand"
                                                            BorderThickness="0" Background="#335C8AE6" Foreground="#BBD4FF"
                                                            VerticalAlignment="Center">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <!-- 自定义模板：悬浮叠白罩提亮底色（前景不变，避免默认系统浅底上亮字看不清） -->
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <Grid>
                                                                                    <Border x:Name="hov" Background="Transparent" CornerRadius="5"/>
                                                                                    <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="hov" Property="Background" Value="#30FFFFFF"/>
                                                                                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="hov" Property="Background" Value="#46FFFFFF"/>
                                                                                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" Foreground="#777"
                                                               FontFamily="Consolas" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               DockPanel.Dock="Right" Margin="0,0,2,0"/>
                                                    <TextBlock Text="{Binding DurationText, Mode=OneWay}" Foreground="#888"
                                                               FontFamily="Consolas" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Visibility="{Binding DurationVisible, Mode=OneWay}"
                                                               DockPanel.Dock="Right" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ContextText, Mode=OneWay}" Foreground="#888"
                                                               FontFamily="Consolas" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                                               Visibility="{Binding ContextVisible, Mode=OneWay}"
                                                               DockPanel.Dock="Right" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="#57D9A3"
                                                               FontFamily="Consolas" FontSize="12.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               DockPanel.Dock="Left"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hb" Property="Background" Value="#0AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border DockPanel.Dock="Top" x:Name="body"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                    <!-- 思考卡展开正文：白字（折叠行绿色标题保留，靠颜色区分标题/内容） -->
                                    <TextBox Text="{Binding Content, Mode=OneWay}" Style="{StaticResource SelText}"
                                             FontFamily="Consolas" FontSize="12.5" Foreground="White"
                                             Margin="14,4" VerticalContentAlignment="Top" MinHeight="0"
                                             TextWrapping="Wrap" MaxWidth="960"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 待办计划卡折叠样式（复用思考条布局，标题/内容用绿色区分计划视角） ============ -->
        <Style x:Key="TodoDetails" TargetType="Expander" BasedOn="{StaticResource ThinkingDetails}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" ClipToBounds="True">
                            <DockPanel>
                                <!-- 标题行：静态展示，无折叠箭头 -->
                                <Border DockPanel.Dock="Top" x:Name="head" Background="Transparent" Padding="14,7">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource AmberBrush}"
                                                   FontFamily="Consolas" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                                <Border DockPanel.Dock="Top" x:Name="body"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                    <TextBox Text="{Binding Content, Mode=OneWay}" Style="{StaticResource SelText}"
                                             FontFamily="Consolas" FontSize="12" Foreground="{StaticResource AmberBrush}"
                                             Margin="14,4" VerticalContentAlignment="Top" MinHeight="0"
                                             TextWrapping="Wrap" MaxWidth="960"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 思考条数据模板 ============ -->
        <DataTemplate DataType="{x:Type local:ThinkingItem}">
            <Expander Style="{StaticResource ThinkingDetails}">
                <Expander.MinWidth>
                    <Binding Path="DataContext.Steps" RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                             Converter="{StaticResource FitWidth}" ConverterParameter="12.5|Consolas|48|min"/>
                </Expander.MinWidth>
                <Expander.MaxWidth>
                    <MultiBinding Converter="{StaticResource FitWidth}" ConverterParameter="12.5|宋体|90">
                        <Binding Path="Title"/>
                        <Binding Path="Content"/>
                    </MultiBinding>
                </Expander.MaxWidth>
            </Expander>
        </DataTemplate>

        <!-- ============ 待办计划卡数据模板（复用思考条折叠样式，标题带进度 N/M） ============ -->
        <DataTemplate DataType="{x:Type local:TodoItem}">
            <Expander Style="{StaticResource TodoDetails}">
                <Expander.MinWidth>
                    <Binding Path="DataContext.Steps" RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                             Converter="{StaticResource FitWidth}" ConverterParameter="12.5|Consolas|48|min"/>
                </Expander.MinWidth>
                <Expander.MaxWidth>
                    <MultiBinding Converter="{StaticResource FitWidth}" ConverterParameter="12|宋体|90">
                        <Binding Path="Title"/>
                        <Binding Path="Content"/>
                    </MultiBinding>
                </Expander.MaxWidth>
            </Expander>
        </DataTemplate>

        <!-- ============ 危险操作确认卡片模板（嵌入时间线，工具卡下方，决策/超时后自动隐藏） ============ -->
        <DataTemplate DataType="{x:Type local:DangerConfirmItem}">
            <Border Background="#33F0A13E" BorderBrush="#F0A13E" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="0,14,0,4"
                    Visibility="{Binding Vis}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ 危险操作待确认" FontSize="13" FontWeight="Bold"
                                   Foreground="#F0A13E"/>
                        <TextBlock Text="{Binding CountdownText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F0A13E" Margin="10,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Content, Mode=OneWay}" FontSize="12"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="✅ 允许执行" Style="{StaticResource DarkActionBtn}" Click="OnDangerAllowClick"
                                Background="#1E8E3E" Foreground="White" FontSize="12"
                                Padding="10,4" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,8,0"/>
                        <Button Content="🚫 取消" Style="{StaticResource DarkActionBtn}" Click="OnDangerCancelClick"
                                Background="#8E3E3E" Foreground="White" FontSize="12"
                                Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============ 改动文件行模板（隐式：左栏"本会话改动"卡片 + 消息底部"本轮改动"条带共用） ============
             一行一个文件：状态标记（+新建=绿 / ~修改=琥珀）+ 文件名 + 相对目录 + 改动时间；
             悬停整行高亮（同 git 变更文件行手感），单击打开代码查看器定位该文件（OnChangedFileClick）。 -->
        <DataTemplate DataType="{x:Type local:ChangedFileVm}">
            <Border x:Name="cfRow" Background="Transparent" CornerRadius="5" Padding="7,3" Cursor="Hand"
                    ToolTip="{Binding Tip}" MouseLeftButtonUp="OnChangedFileClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="cfMark" Grid.Column="0" Text="{Binding StatusIcon}" FontFamily="Consolas"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11.5"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DirText}" FontSize="10"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                               Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding TimeText}" FontSize="10"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 新建文件用绿色标记，与"修改"的琥珀色区分 -->
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="cfMark" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                </DataTrigger>
                <Trigger SourceName="cfRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="cfRow" Property="Background" Value="#14FFFFFF"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ 单条消息模板 ============ -->
        <DataTemplate DataType="{x:Type local:ChatMessage}">
            <Grid Margin="0,0,0,12">
                <!-- 单列全宽：Agent 内容拉到右缘、用户气泡拉到左缘（不再限宽 640/半宽列） -->

                <!-- Agent 消息 -->
                <Grid Visibility="{Binding AgentVisible}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                            Background="{StaticResource GradAv}" VerticalAlignment="Top" Margin="0,0,12,0"
                            ToolTip="{Binding AvatarTitle}">
                        <!-- FontSize=16：30×30 头像内的 G 字符放大显示（不撑破 Border，仍居中） -->
                        <TextBlock Text="G" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding Who, Mode=OneWay}" Style="{StaticResource SelText}"
                                     FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,0,5"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 时间序布局：进度/收缩条 → 执行过程卡片（分析思路+工具卡） → 结果气泡 -->
                        <Border Tag="MsgStepsStrip" Background="#40000000" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                MaxWidth="{Binding Steps, Converter={StaticResource FitWidth}, ConverterParameter='12.5|Consolas|48'}"
                                Visibility="{Binding StepsVisible}"
                                Cursor="{Binding StepsCursor}" PreviewMouseLeftButtonUp="OnStepsClick"
                                ToolTip="{Binding StepsTip}">
                            <!-- TextBox 不命中测试：点击直达 Border，避免 TextBox 鼠标捕捉/吞事件；保留 UIA 钩子 -->
                            <TextBox Text="{Binding Steps, Mode=OneWay}" Style="{StaticResource SelText}"
                                     IsHitTestVisible="False" Focusable="False"
                                     TextWrapping="NoWrap"
                                     AutomationProperties.AutomationId="stepsBar"
                                     FontFamily="Consolas" FontSize="12.5"
                                     Foreground="{StaticResource GreenBrush}"
                                     Cursor="{Binding StepsCursor}"/>
                        </Border>
                        <!-- 过程卡片：把每轮分析思路和工具调用整体收纳，随 Steps 展开/收缩 -->
                        <Border Background="#252532" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="12" Padding="16,12" Margin="0,8,0,0"
                                HorizontalAlignment="Left" MinWidth="360"
                                Visibility="{Binding ProcessVisible}">
                            <StackPanel>
                                <!-- 执行过程时间线：思考条与工具卡按发生顺序交错排列（隐式模板按类型自动匹配） -->
                                <ItemsControl ItemsSource="{Binding ProcessItems}" Margin="0,0,0,8"
                                              HorizontalAlignment="Left" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <!-- 正在工作提示：工具条区（过程卡片）下方、GAIRR 结果气泡上方，左侧文字（思考/执行切换）+ 右侧动态图标 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding WaitingVisible}"
                                    Margin="8,8,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WaitingText}" FontSize="12"
                                       Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- ============ 等待动画按状态分流（A/B/C 保留；D 旋转亮弧已迁至工具卡右侧状态位） ============ -->
                                <!-- 样式：A 追灯扫点 / B 波浪均衡器 / C 跳动小球。每组的 Visibility 由 Style.Triggers -->
                                <!-- 按 WaitingText 精确匹配：A=“正在思考”，B=“正在整理上下文”，C=“正在执行”；尺寸：A/C 球径 4、B 柱宽 3、间距均 3；B 柱圆角固定 1（与高度无关，柱宽轮廓恒为 3，起伏时不变宽窄） -->
                                <!-- A · 追灯扫点：WaitingText=“正在思考”时显示（同模板实例按各自消息状态互斥切换） -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            ToolTip="A · 追灯扫点：单亮点从左到右依次扫过，1.5s 一圈">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WaitingText}" Value="正在思考">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0.15"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="0.15"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.72" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.90" Value="0.15"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.02" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.20" Value="0.15"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.32" Value="1"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:1.50" Value="0.15"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </StackPanel>
                                <!-- B · 波浪均衡器：WaitingText=“正在整理上下文”时显示 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            ToolTip="B · 波浪均衡器：5 根细条高度波浪起伏，2s 一波；柱宽恒 3，只动高度">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WaitingText}" Value="正在整理上下文">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Width="3" Height="13" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Rectangle RadiusX="1" RadiusY="1" Fill="{StaticResource GreenBrush}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="4">
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Height" Duration="0:0:2">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="13"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                    <Grid Width="3" Height="13" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Rectangle RadiusX="1" RadiusY="1" Fill="{StaticResource GreenBrush}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="4">
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Height" Duration="0:0:2">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.65" Value="13"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.95" Value="4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                    <Grid Width="3" Height="13" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Rectangle RadiusX="1" RadiusY="1" Fill="{StaticResource GreenBrush}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="4">
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Height" Duration="0:0:2">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.00" Value="13"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.30" Value="4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                    <Grid Width="3" Height="13" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Rectangle RadiusX="1" RadiusY="1" Fill="{StaticResource GreenBrush}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="4">
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Height" Duration="0:0:2">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="13"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                    <Grid Width="3" Height="13" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Rectangle RadiusX="1" RadiusY="1" Fill="{StaticResource GreenBrush}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="4">
                                            <Rectangle.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Height" Duration="0:0:2">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="4"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.70" Value="13"/>
                                                                <LinearDoubleKeyFrame KeyTime="0:0:2.00" Value="4"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Rectangle.Triggers>
                                        </Rectangle>
                                    </Grid>
                                </StackPanel>
                                <!-- C · 跳动小球（跳跳圆）：WaitingText=“正在执行”时显示（5 个圆点依次起跳回落，多米诺弹跳，1s 一轮） -->
                                <!-- A/C 球径 4，B 音乐柱柱宽 3，间距均 3，视觉密度一致 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                            ToolTip="C · 跳动小球：5 个圆点依次起跳回落，多米诺弹跳，1s 一轮">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WaitingText}" Value="正在执行">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- 球 1：0.10s 起跳 -->
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="4"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <!-- 球 2：0.25s 起跳 -->
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="4"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <!-- 球 3：0.40s 起跳 -->
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.40" Value="4"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <!-- 球 4：0.55s 起跳 -->
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="4"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <!-- 球 5：0.70s 起跳（末球，间距同前保持整组密度均匀） -->
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" Margin="0,0,3,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Duration="0:0:1">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.70" Value="4"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.90" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </StackPanel>
                                <!-- D · 旋转亮弧（光环）：已迁至工具卡 ToolDetails 头部右侧状态位，Status="…" 时显示（见 415 行后） -->
                            </StackPanel>
                        </StackPanel>
                        <!-- 气泡（最终结果，始终排在执行过程卡片之后）：失败/异常时气泡右侧追加「重试」图标（等效手工回复“继续”），正常消息不出现 -->
                        <DockPanel LastChildFill="False" HorizontalAlignment="Left">
                        <Border DockPanel.Dock="Left" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="3,14,14,14" Padding="16,12" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                Visibility="{Binding BubbleVisible}">
                            <StackPanel>
                                <TextBox Text="{Binding Cmd, Mode=OneWay}" Style="{StaticResource SelText}"
                                         FontFamily="Consolas" FontSize="13"
                                         Foreground="{StaticResource AmberBrush}"
                                         Visibility="{Binding CmdVisible}"/>
                                <!-- 安全警报：被拦截/取消时红色气泡，普通结果继续 Markdown 渲染 -->
                                <Border Background="#33F04E4E" BorderBrush="#F04E4E" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="0,6,0,0"
                                        Visibility="{Binding IsAlert, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold"
                                                   Foreground="{Binding AlertLevel, Converter={StaticResource AlertToBrush}}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  {1}">
                                                    <Binding Path="AlertLevel" Converter="{StaticResource LevelLabelConv}"/>
                                                    <Binding Path="Who"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <!-- 危险确认中：允许执行 / 取消 按钮（决策后自动收起） -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding DangerActionsVisible}">
                                            <Button Content="✅ 允许执行" Style="{StaticResource DarkActionBtn}" Click="OnDangerAllowClick"
                                                    Background="#1E8E3E" Foreground="White" FontSize="12"
                                                    Padding="10,4" BorderThickness="0" Cursor="Hand"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="🚫 取消" Style="{StaticResource DarkActionBtn}" Click="OnDangerCancelClick"
                                                    Background="#8E3E3E" Foreground="White" FontSize="12"
                                                    Padding="10,4" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <FlowDocumentScrollViewer Document="{Binding Text, Mode=OneWay, Converter={StaticResource MdConv}, ConverterParameter='Microsoft YaHei, SimSun, Segoe UI'}"
                                         Visibility="{Binding IsAlert, Converter={StaticResource InverseBoolToVis}}"
                                         IsSelectionEnabled="True" FontSize="13" FontFamily="Microsoft YaHei, SimSun, Segoe UI"
                                         Foreground="{StaticResource TextBrush}"
                                         Background="Transparent" Padding="0" Margin="0,6,0,0"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"/>
                                <TextBox Text="{Binding Note, Mode=OneWay}" Style="{StaticResource SelText}"
                                         FontSize="13" Foreground="{StaticResource DimBrush}"
                                         Margin="0,4,0,0" Visibility="{Binding NoteVisible}"/>
                            </StackPanel>
                        </Border>
                        <!-- 失败/异常气泡「重试」入口：Visibility 由 RetryVisible 驱动（仅 ⚠/发送失败 终态气泡显示），点击等效手工回复“继续” -->
                        <Button DockPanel.Dock="Left" Content="↻ 重试" Style="{StaticResource DarkActionBtn}"
                                Click="OnRetryBubbleClick" Cursor="Hand"
                                ToolTip="任务失败/中止后继续执行（等效手工回复「继续」）"
                                Visibility="{Binding RetryVisible}"
                                VerticalAlignment="Center" Margin="10,8,0,0"
                                Background="#3A3F5A" Foreground="{StaticResource AmberBrush}"
                                FontSize="12" Padding="10,5" BorderThickness="0"/>
                        </DockPanel>

                        <!-- ============ 本轮改动条带（每轮回复各自的改动文件）：正文气泡下方一行摘要，点击展开文件清单。
                             数据来源：本轮 SessionRunResult.ChangedFiles（按任务时间窗聚合），收口时写入本消息并随
                             MessageRecord.ChangedFiles 持久化，历史回放同样显示；纯问答/只读轮次无文件 → 整条 Collapsed。
                             摘要行仿 Steps 条样式（深色圆角小条 + 琥珀文案 + 右侧 ▾/▸ 折叠箭头），点击切换展开。 ============ -->
                        <Border Tag="RoundChangesStrip" Background="#40000000" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Visibility="{Binding ChangesVisible}"
                                Cursor="Hand" PreviewMouseLeftButtonUp="OnChangesToggle"
                                ToolTip="本轮回复改动的文件（点击展开/收起）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ChangesText}" FontSize="12.5" FontFamily="Consolas"
                                           Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChangesArrow}" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 展开后的文件清单：复用左栏"本会话改动"卡片的 ChangedFileVm 隐式行模板，单击文件行打开代码查看器 -->
                        <Border Background="#252532" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="10" Padding="10,7" Margin="0,6,0,0"
                                HorizontalAlignment="Left" MinWidth="360"
                                Visibility="{Binding ChangesListVisible}">
                            <ItemsControl ItemsSource="{Binding RoundChanges}"/>
                        </Border>

                        <!-- 编排问题卡片区（收集期主持人以卡片提问：点选/打勾作答，无需手打；提交后折叠为一行摘要） -->
                        <Border Background="#20243A" BorderBrush="#3A4566" BorderThickness="1" CornerRadius="10"
                                Padding="12,10" Margin="0,10,0,0" HorizontalAlignment="Left" MaxWidth="720"
                                Visibility="{Binding QuestionCardsVisible}">
                            <Border.Resources>
                                <!-- 选项行内容：选项文本 + 模型推荐徽标（⭐ 推荐） -->
                                <DataTemplate x:Key="OptContent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Text}" FontSize="12.5"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                   MaxWidth="540" VerticalAlignment="Center"/>
                                        <Border Background="#26F5B955" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                Visibility="{Binding Rec, Converter={StaticResource BoolToVis}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="⭐ 推荐" FontSize="10" Foreground="#F5B955"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </Border.Resources>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding QuestionCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:QuestionCardVm}">
                                        <Border BorderBrush="#33415E" BorderThickness="1" CornerRadius="8"
                                                Background="#0FFFFFFF" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- 题面：会话内自增序号（琥珀强调）+ 题目文本 -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding No, StringFormat={}{0}.}" FontSize="13" FontWeight="Bold"
                                                               Foreground="#F5B955" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                                    <TextBlock Text="{Binding Question}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                               MaxWidth="608" VerticalAlignment="Top" Margin="7,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding MultiTip}" FontSize="10.5"
                                                           Foreground="{StaticResource DimBrush}" Margin="22,3,0,0"/>
                                                <!-- 选项（单选 RadioButton / 多选 CheckBox，按 Multi 切换） -->
                                                <ItemsControl ItemsSource="{Binding Options}" Margin="14,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <CheckBox x:Name="optChk" VerticalAlignment="Center" Cursor="Hand"
                                                                          IsTabStop="False" Visibility="Collapsed"
                                                                          Content="{Binding}"
                                                                          ContentTemplate="{StaticResource OptContent}"
                                                                          Checked="OnQOptionToggled" Unchecked="OnQOptionToggled"/>
                                                                <RadioButton x:Name="optRad" VerticalAlignment="Center" Cursor="Hand"
                                                                             IsTabStop="False"
                                                                             GroupName="{Binding DataContext.CardId, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                             Content="{Binding}"
                                                                             ContentTemplate="{StaticResource OptContent}"
                                                                             Checked="OnQOptionToggled" Unchecked="OnQOptionToggled"/>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.Multi, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter TargetName="optChk" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="optRad" Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- 操作行：提交 / 补充说明 / 校验提示 -->
                                                <StackPanel Orientation="Horizontal" Margin="14,10,0,0"
                                                            Visibility="{Binding ActionVisible}">
                                                    <!-- 单卡：卡内提交按钮；多卡时让位于消息底部公共提交条（一次性提交全部） -->
                                                    <Button Content="✓ 提交答案" Click="OnCardSubmitClick"
                                                            Style="{StaticResource DarkActionBtn}" Cursor="Hand"
                                                            Padding="12,4" FontSize="12" FontWeight="SemiBold"
                                                            Background="#1E6F44" Foreground="White" Margin="0,0,8,0"
                                                            Visibility="{Binding DataContext.MultiCardMode, RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                                 Converter={StaticResource InverseBoolToVis}}"/>
                                                    <Button Content="✏️ 补充说明" Click="OnCardExtraClick"
                                                            Style="{StaticResource DarkActionBtn}" Cursor="Hand"
                                                            Padding="12,4" FontSize="12" FontWeight="SemiBold"
                                                            Background="#33415E" Foreground="#DDE2F0"/>
                                                    <TextBlock Text="请至少选择一项，或在补充说明中作答" Foreground="#F0A13E"
                                                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Visibility="{Binding ErrorVisible}"/>
                                                </StackPanel>
                                                <!-- 补充说明输入框（点「✏️ 补充说明」展开；选项不合适/需要细述时使用） -->
                                                <TextBox Text="{Binding ExtraText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding ExtraVisible}" MinHeight="52" MaxHeight="96"
                                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="12.5"
                                                         Foreground="{StaticResource TextBrush}"
                                                         Background="#0F1017" BorderBrush="#3A4566" BorderThickness="1"
                                                         Padding="8,4" Margin="14,8,0,0"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <!-- 已提交：折叠摘要（答案同时以用户消息进入历史） -->
                                                <TextBlock Visibility="{Binding AnswerVisible}" FontSize="12.5"
                                                           Foreground="#3DDC97" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Summary, Mode=OneWay}" Margin="2,2,0,0"
                                                           ToolTip="已作为你的回答发送给主持人"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 多卡公共提交条：同一条消息多张卡时显示在卡组底部；有未完成题目时按钮禁用，
                                 全部作答完成才可点击，一次性把本批答案作为一条用户消息提交（提交后整批折叠） -->
                            <StackPanel Orientation="Horizontal" Margin="14,4,0,0"
                                        Visibility="{Binding MultiSubmitVisible}">
                                <Button Content="✓ 提交答案" Click="OnCardsSubmitAllClick"
                                        Style="{StaticResource DarkActionBtn}" Cursor="Hand"
                                        Padding="12,4" FontSize="12" FontWeight="SemiBold"
                                        Background="#1E6F44" Foreground="White"
                                        IsEnabled="{Binding AllCardsDone}"
                                        ToolTip="一次性提交本批全部题目的作答（作为一条回答发给主持人）"/>
                                <TextBlock Text="{Binding MultiSubmitHint}" Foreground="#F0A13E" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding MultiSubmitHintVisible}"/>
                                <TextBlock Text="{Binding MultiSubmitError}" Foreground="#F04E4E" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding MultiSubmitErrorVisible}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>

                <!-- 用户消息 -->
                <Grid Visibility="{Binding UserVisible}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding Who, Mode=OneWay}" Style="{StaticResource SelText}"
                                 FontSize="11" Foreground="{StaticResource DimBrush}"
                                 HorizontalAlignment="Right" Margin="0,0,0,5"/>
                        <Border Background="{StaticResource GradUserBubble}"
                                CornerRadius="14,3,14,14" Padding="16,12" HorizontalAlignment="Right"
                                MaxWidth="{Binding Text, Converter={StaticResource FitWidth}, ConverterParameter='14|Microsoft YaHei|40'}">
                            <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelText}"
                                     FontSize="13" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8"
                            Background="{StaticResource P1Brush}" VerticalAlignment="Top" Margin="12,18,0,0">
                        <TextBlock Text="你" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- ================= 主体：自绘标题栏 + 左侧栏 260 + 对话区 ================= -->
    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="347" MinWidth="250" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 自绘标题栏：左侧项目自适应宽度，右侧模型与窗口控制占剩余空间 ============ -->
        <Border x:Name="titleBar" Grid.Row="0" Grid.ColumnSpan="3" Height="44"
                Background="{StaticResource SideBgBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleDrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 左侧：LOGO（项目选择框与"添加项目 +"已移至左侧栏"项目"面板顶部，替换原路径小字） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center">
 <Border Background="Black" CornerRadius="6" Padding="8,3" Margin="0,0,0,0"
                            BorderBrush="#2EFFFFFF" BorderThickness="1"
                            Height="30" VerticalAlignment="Center">
                        <TextBlock x:Name="appLogoText" Text="GAIRR" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <!-- 右侧：模型切换 + 思考 + GPU 监控 + 最小化/最大化/关闭 -->
                <!-- 右边距 6：关闭按钮不贴窗口右缘 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <!-- 工作模式选择器：角色/模式仓库（roles/<角色名>/role.json 角色包目录形态，旧扁平 roles/*.json 首次启动自动迁移为目录；
                         两级 JSON 免编译自定义：角色=身份壳，模式=提示词+可选流程） -->
                    <ComboBox x:Name="cbMode" Style="{StaticResource ModelCombo}" Width="190"
                              Height="30" VerticalAlignment="Center" Margin="0,0,10,0"
                              SelectionChanged="OnCbModeChanged"
                              DropDownOpened="OnCbModeDropDownOpened"
                              ToolTip="角色 · 工作模式：改工具目录 roles/ 下角色包可新增角色与模式（免编译热加载；旧扁平 roles/*.json 首次启动自动迁移为 roles/ 下角色包目录）。角色=谁在用（身份壳），模式=怎么干活（提示词 + 可选流程）">
                        <ComboBoxItem Content="🤖 自动匹配（角色-模式）" IsSelected="True" Style="{StaticResource DarkComboItem}"/>
                    </ComboBox>
                    <ComboBox x:Name="modelSel" Style="{StaticResource ModelCombo}" Width="220"
                              Height="30" VerticalAlignment="Center"
                              SelectionChanged="OnModelSelChanged"
                              DropDownOpened="OnModelSelDropDownOpened">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <!-- 未配 key / 厂商并发已满 的选项真正禁选：不响应点击与悬停高亮（外观由模板灰/桔形态呈现） -->
                                <Setter Property="IsEnabled" Value="{Binding Selectable}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 正常形态：厂商名着强调紫、模型名保持正文色；无 key 的选项灰显并标注"未配置" -->
                                    <StackPanel x:Name="NormalView" Orientation="Horizontal" IsEnabled="{Binding HasKey}">
                                        <TextBlock Text="{Binding ProviderDisplay}" Foreground="#C9A0FF"
                                                   FontSize="11.5" VerticalAlignment="Center"
                                                   Opacity="{Binding HasKey, Converter={StaticResource BoolToOpacity}}"/>
                                        <TextBlock Text=" - " Foreground="{StaticResource DimBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center"
                                                   Opacity="{Binding HasKey, Converter={StaticResource BoolToOpacity}}"/>
                                        <!-- 模型名：正常为正文色；仅当"这个具体模型"正在被使用时（InUse）由下方触发器改为金色，
                                             同厂商其它空闲模型不着色 -->
                                        <TextBlock x:Name="ModelNameText" Text="{Binding ModelId}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center"
                                                   Opacity="{Binding HasKey, Converter={StaticResource BoolToOpacity}}"/>
                                        <!-- 模型调用异常标记：该模型最近一次调用以"模型异常"收尾（额度/网络等重试无效），
                                             显示 ⚠异常 红标；模型仍可选（点击即重试），重试成功由 Finished 收口自动消除 -->
                                        <TextBlock x:Name="FaultTag" Text="⚠异常" Foreground="#F04E4E"
                                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="Collapsed"/>
                                        <TextBlock Text=" (未配置)" Foreground="{StaticResource DimBrush}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding HasKey, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>
                                    <!-- 并发满额形态（厂商级）：标注"（满额）"且容器已禁选；默认可见，
                                         由下方 Full=False 触发器收起（不设本地 Visibility 以防压过触发器）。
                                         行内文字色走继承（TextElement.Foreground）：默认灰（禁选态），
                                         只有本项模型正在被使用时由下方 InUse 触发器转金色，避免同厂商空闲模型被整片涂金 -->
                                    <StackPanel x:Name="BusyView" Orientation="Horizontal" IsEnabled="False"
                                                TextElement.Foreground="{StaticResource DimBrush}">
                                        <TextBlock Text="{Binding ProviderDisplay}"
                                                   FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Text=" - "
                                                   FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ModelId}"
                                                   FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="（满额）" Foreground="#FFB45E"
                                                   FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Full}" Value="True">
                                        <Setter TargetName="NormalView" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Full}" Value="False">
                                        <Setter TargetName="BusyView" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- 正在被使用（精确到本模型）：模型名称着金色；厂商名仍为强调紫，整行保持可选 -->
                                    <DataTrigger Binding="{Binding InUse}" Value="True">
                                        <Setter TargetName="ModelNameText" Property="Foreground" Value="#F0A13E"/>
                                        <!-- 满额形态下同时命中：整行文字转金色 → 金色 +（满额），表示"这个模型正跑满" -->
                                        <Setter TargetName="BusyView" Property="TextElement.Foreground" Value="#F0A13E"/>
                                    </DataTrigger>
                                    <!-- 模型调用异常（最近一次以"模型异常"收尾）：模型名转红 + ⚠异常 红标；
                                         放在 InUse 之后使红色优先于"在用"金色；该模型仍可选（点击即重试） -->
                                    <DataTrigger Binding="{Binding Faulted}" Value="True">
                                        <Setter TargetName="ModelNameText" Property="Foreground" Value="#F04E4E"/>
                                        <Setter TargetName="FaultTag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- 思考控件：按当前模型 [ModelThinking] 规则动态渲染——开关按钮（开/关模式）、下拉（等级模式）、隐藏（未配置规则的模型） -->
                    <Button x:Name="thinkingBtn" Content="思考" Style="{StaticResource ThinkingToggle}"
                            Height="30" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="OnThinkingClick" ToolTip="大模型思考模式开关：开=保留思维链推理，关=直接输出结果"/>
                    <ComboBox x:Name="thinkingLevelSel" Height="30" Margin="10,0,0,0" VerticalAlignment="Center"
                              Style="{StaticResource ThinkingLevelCombo}" Visibility="Collapsed"
                              SelectionChanged="OnThinkingLevelChanged"
                              ToolTip="思考等级（档位来自模型配置）"/>
 <!-- 网页通道开关（仅选用「网页-xxx」模型时出现）：与「思考」同款开关样式，亮=窗口已显示，暗=窗口在后台静默 -->
 <Button x:Name="btnWebWin" Content="网页" Style="{StaticResource ThinkingToggle}"
 Height="30" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
 Click="OnToggleWebWin" ToolTip="网页模型窗口显示/隐藏：亮=窗口已显示，暗=窗口在后台静默运行"/>
                    <!-- 本地模型 GPU 资源状态：固定于思考开关右侧；显存/利用率/温度三色柱（GpuMonitor 每 15 秒轮询驱动，离线变灰）
                         极简窄版：只显示标签 + 色柱，不显示右侧数值（具体百分比/温度见悬停 Tip 明细） -->
                    <Border x:Name="gpuPanel" Height="30" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Padding="4,0" Background="#14FFFFFF" CornerRadius="5" BorderBrush="#26FFFFFF" BorderThickness="1"
                            ToolTip="{Binding Tip, Source={x:Static local:GpuMonitor.Current}}"
                            DataContext="{Binding Source={x:Static local:GpuMonitor.Current}}">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="显存" FontSize="7" Foreground="#8A93A6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource GpuBar}" Width="38"
                                             Value="{Binding Vram, Mode=OneWay}" Foreground="{Binding VramBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="利用" FontSize="7" Foreground="#8A93A6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource GpuBar}" Width="38"
                                             Value="{Binding Util, Mode=OneWay}" Foreground="{Binding UtilBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="温度" FontSize="7" Foreground="#8A93A6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource GpuBar}" Width="38"
                                             Value="{Binding Temp, Mode=OneWay}" Foreground="{Binding TempBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- 窗口控制按钮：最小化 / 最大化 / 关闭 -->
                    <!-- 窗口控制区不再放网页按钮（已迁至思考控件旁）
                         站点未登录时会被自动弹出让用户登录；已登录则一直在后台静默运行 -->
                    <!-- 网页显示/隐藏按钮已迁至思考控件旁（见上方 btnWebWin），此处旧按钮移除 -->
                            
                    <Button x:Name="btnMin" Content="—" Style="{StaticResource CapBtn}" Margin="15,0,0,0" Click="OnWinMin"/>
                    <Button x:Name="btnMax" Content="□" Style="{StaticResource CapBtn}" Click="OnWinMax"/>
                    <Button x:Name="btnClose" Content="✕" Style="{StaticResource CapCloseBtn}" Click="OnWinClose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 左侧栏 ============ -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SideBgBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0"
                SizeChanged="OnSideSizeChanged">
            <DockPanel>
                <!-- 标签页：项目 / 架构 / 会话 / 任务 / 技能 -->
                <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="12,4,12,0">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource TabBtn}"/>
                    </UniformGrid.Resources>
                    <Button x:Name="tabDir" Content="项目" Tag="cur" Click="OnTabClick"/>
                    <Button x:Name="tabArch" Content="架构" Click="OnTabClick"/>
                    <Button x:Name="tabHistory" Click="OnTabClick">
                        <Grid>
                            <!-- 标题恒居中：徽标不再并入标题流把标题顶偏（无数字时空占位、有数字时整体偏左）；
                                 徽标作独立角标固定在标题右外侧（相对按钮中心偏移约半字宽+间距），Collapsed 时标题仍在正中 -->
                            <TextBlock Text="会话" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="tabHistoryBadge" Text="" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="18,1,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="tabTask" Content="任务" Click="OnTabClick"/>
                    <Button x:Name="tabSkill" Content="技能" Click="OnTabClick"/>
                </UniformGrid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,0"/>

                <!-- 底部版权行：左=点击跳官网；右=手机端服务开关（调 mobile-service.bat start/stop 启停本机 Server+公网隧道） -->
                <Grid DockPanel.Dock="Bottom" Margin="20,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="footYear" FontSize="12" Foreground="{StaticResource DimBrush}"
                               Cursor="Hand" MouseLeftButtonUp="OnFootClick" VerticalAlignment="Center"
                               ToolTip="打开官网 gairr.com"/>
                    <!-- 切换按钮左侧的“手机端”标签 -->
                    <TextBlock Grid.Column="1" Text="手机端" FontSize="11" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <ToggleButton Grid.Column="2" x:Name="mobileSvcSwitch" Style="{StaticResource DarkSwitchMini}"
                                  VerticalAlignment="Center"
                                  ToolTip="手机端服务：开=本机 GAIRR.Server+SSH 公网隧道（手机经 app.gairr.com 连接）；关=全部停止"
                                  Click="OnMobileSvcToggle"/>
                </Grid>

                <!-- 内容区：四个面板切换 -->
                <Grid>
                    <!-- 面板1：项目目录树 -->
                    <Grid x:Name="panelDirRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 顶行（Grid 四列）：项目选择框（自标题栏移入，替换原路径小字，宽度随侧栏自适应）+ 添加项目 + ｜ 全部收缩 - + 重建地图；
                             完整项目路径改挂 projSel 的 ToolTip（RenderTree 写入） -->
                        <Grid Grid.Row="0" Margin="12,14,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="projSel" Grid.Column="0" Style="{StaticResource ProjCombo}"
                                      Height="30" VerticalAlignment="Center"
                                      SelectionChanged="OnProjectChanged"/>
                            <Button x:Name="projAddBtn" Grid.Column="1" Content="+" Width="24" Height="24"
                                    Style="{StaticResource AddBtn}" Padding="0" FontSize="14" Foreground="{StaticResource DimBrush}"
                                    Margin="6,0,0,0" Click="OnProjectAdd" ToolTip="添加新项目目录" VerticalAlignment="Center"/>
                            <Button x:Name="rebuildMapBtn" Grid.Column="3" Height="24" MouseEnter="MapBtnMouseEnter" MouseLeave="MapBtnMouseLeave"
                                    FontSize="10" Padding="6,2" Foreground="{StaticResource GreenBrush}"
                                    Background="Transparent" BorderBrush="#7A8C9B" BorderThickness="1"
                                    Cursor="Hand" Click="OnRebuildMap" ToolTip="全量重建地图缓存与符号索引（清除派生缓存后重建，并检查标签合规）"
                                    HorizontalAlignment="Right">
                                <Grid x:Name="mapBtnContentGrid" MinWidth="72">
                                    <TextBlock x:Name="mapBtnProgressText" Text="重建地图" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#15FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DimBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- 全部收缩（- 号，与同行“添加项目 +”同款 AddBtn）：折叠项目跟踪树全部节点到根分组 -->
                            <Button x:Name="dirCollapseBtn" Grid.Column="2" Content="-" Width="24" Height="24"
                                    Style="{StaticResource AddBtn}" Padding="0" FontSize="14" Foreground="{StaticResource DimBrush}"
                                    Margin="8,0,4,0" Click="OnCollapseAll" ToolTip="全部收缩：折叠树全部节点"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer x:Name="panelDir" Grid.Row="1" Style="{StaticResource DirScrollViewer}"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto"
                                      Padding="12,0,12,14">
                            <!-- 层级树：TreeView + HierarchicalDataTemplate 支持展开/收缩/选中 -->
                            <TreeView x:Name="treeBox" Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonUp="OnTreeNodeClick"
                                      PreviewMouseDoubleClick="OnTreeNodeDoubleClick"
                                      PreviewMouseRightButtonDown="OnTreeRightDown"
                                      ContextMenuOpening="OnTreeMenuOpening"
                                      SelectedItemChanged="OnTreeSelectedChanged"
                                      PreviewMouseWheel="OnTreeWheel">
<TreeView.ContextMenu>
                                <!-- 节点右键：加入会话/自动维护文档（目录与文件）；项目跟踪组上另有刷新项；git 行/分组无菜单项（打开前拦截） -->
                                <ContextMenu>
                                    <!-- 分组节点右键项：项目跟踪（Git 变更）组上提供刷新；文件/目录节点项其余按命中类型显隐 -->
                                    <MenuItem x:Name="menuGitRefresh" Header="刷新提交记录" Click="OnGitRefreshClick" Visibility="Collapsed"/>
                                    <Separator x:Name="menuSep1"/>
                                    <MenuItem x:Name="menuAddToSession" Header="加入到会话" Click="OnTreeAddToSession"/>
                                    <Separator x:Name="menuSep2"/>
                                    <MenuItem x:Name="menuAddAutoDoc" Header="加入自动维护文档" Click="OnToggleAutoDoc"/>
                                    <MenuItem x:Name="menuRemoveAutoDoc" Header="移出自动维护文档" Click="OnToggleAutoDoc"/>
                                </ContextMenu>
</TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <!-- 窄深色滚动条 -->
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="6"/>
                                        <Setter Property="Height" Value="6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="Transparent">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border CornerRadius="3" Background="#2A2A3A" Margin="1"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Orientation" Value="Horizontal">
                                                            <Setter Property="Height" Value="6"/>
                                                            <Setter Property="Width" Value="Auto"/>
                                                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- 展开/收缩箭头样式（> 和 v 折线） -->
                                    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Width" Value="16"/>
                                        <Setter Property="Height" Value="16"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Width="16" Height="16" Padding="4,4,4,4">
                                                        <Path x:Name="ExpandPath" Fill="Transparent" Stroke="#8888A0" StrokeThickness="1.5"
                                                              StrokeLineJoin="Round"
                                                              Data="M 1 0 L 5 4 L 1 8"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ExpandPath" Property="Data" Value="M 0 1 L 4 5 L 8 1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsOpen, Mode=TwoWay}"/>
                                        <!-- 控件选中态与模型双向绑定：右键经代码改 IsSelected 也能驱动模板触发器高亮 -->
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        <!-- .NET 9 才有 BringIntoViewOnSelectionChanged，.NET 8 改为代码层处理 -->
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Foreground" Value="{Binding Foreground}"/>
                                        <EventSetter Event="Expanded" Handler="OnTreeExpanded"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                            <Grid Margin="{Binding Margin, Mode=OneTime}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="19"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander" ClickMode="Press"
                                                                              VerticalAlignment="Top"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Style="{StaticResource ExpandCollapseToggleStyle}"
                                                                              Grid.Column="0"/>
                                                                <ContentPresenter x:Name="PART_Header"
                                                                                  ContentSource="Header"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"/>
                                                        <!-- 层级引导竖线：x=2+16L 从父行箭头中心下方垂下，贯穿本行与展开的子区；Level 0 顶行不画 -->
                                                        <Border x:Name="GuideLine" Grid.RowSpan="2" Width="1"
                                                                HorizontalAlignment="Left"
                                                                Background="#333B4F"
                                                                Margin="{Binding Level, Converter={StaticResource TreeGuideMargin}}"
                                                                Visibility="{Binding Level, Converter={StaticResource TreeGuideVis}}"
                                                                IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="HasItems" Value="false">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                        <!-- 选中背景：焦点内/外统一 #26304E（面板 #14151F 上偏亮蓝灰，清晰可辨） -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#26304E"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="IsSelectionActive" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#26304E"/>
                                                        </MultiTrigger>
                                                        <Trigger Property="IsEnabled" Value="false">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
                                        <!-- 两行布局：主行名称按类型着色；次行 Sub 小字仅 git 节点（commit 时间线/变更文件行数），空则整行不占位 -->
                                        <StackPanel ToolTip="{Binding Tip}">
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12.5"
                                                       Foreground="{Binding Foreground}"/>
                                            <TextBlock Text="{Binding Sub}" FontFamily="Consolas" FontSize="10.5"
                                                       Foreground="{StaticResource DimBrush}" Margin="1,1,0,0"
                                                       Visibility="{Binding SubVisible}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </Grid>

                    <!-- 面板2：任务列表 —— 自动执行任务列表 + 执行历史 -->
                    <Grid x:Name="panelTaskRoot" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="18,14,12,10">
                            <Button x:Name="btnAddTask" Content="+ 新增任务" DockPanel.Dock="Right" Height="24"
                                    Style="{StaticResource AddBtn}" Padding="6,2" FontSize="10"
                                    Click="OnAddTaskClick" Margin="0,0,6,0"/>
                            <TextBlock Text="任务列表" Style="{StaticResource SecTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" Grid.RowSpan="1" x:Name="panelTask" Style="{StaticResource HiddenScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Padding="12,0,12,8" MaxHeight="320">
                            <ItemsControl x:Name="taskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TaskItem}">
                                        <Border Style="{StaticResource RowBox}" Cursor="Hand"
                                                Background="{Binding SelectedBg, Mode=OneWay}"
                                                MouseLeftButtonUp="OnTaskCardClick"
                                                PreviewMouseRightButtonDown="OnTaskCardRightClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Fill="{Binding DotBrush, Mode=OneWay}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ScheduleText, Mode=OneWay}" FontSize="12"
                                                               Foreground="{StaticResource DimBrush}" Margin="0,2,0,0"/>
                                                    <!-- 运行中进度行：仅自动任务执行时可见（调度器切换 RunningVisible） -->
                                                    <Grid Visibility="{Binding RunningVisible, Mode=OneWay}" Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0" Style="{StaticResource GpuBar}"
                                                                     Width="120" Height="4" HorizontalAlignment="Left"
                                                                     Foreground="#3E7BFA"
                                                                     Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText, Mode=OneWay}"
                                                                   FontSize="11" Foreground="#3E7BFA" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Click="OnTaskToggle"
                                                              Style="{StaticResource DarkSwitch}"
                                                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="18,10,12,6">
                                <!-- 刷新按钮：重新从磁盘读取任务执行历史（含运行中任务刚落盘的骨架记录） -->
                                <Button DockPanel.Dock="Right" Click="OnRefreshTaskRuns" ToolTip="刷新任务执行历史"
                                        Cursor="Hand" VerticalAlignment="Center" Margin="0,-1,0,0"
                                        FontFamily="Segoe UI Symbol" FontSize="12" Padding="4,0"
                                        Foreground="{StaticResource DimBrush}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="ico" Text="&#xE149;"
                                                       Foreground="{StaticResource DimBrush}"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ico" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="任务执行历史" Style="{StaticResource SecTitle}" Margin="0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" x:Name="panelTaskRuns" Style="{StaticResource HiddenScrollViewer}"
                                          VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                                <ItemsControl x:Name="taskRunList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:TaskRunItem}">
                                            <Border Style="{StaticResource RowBox}"
                                                    Cursor="{Binding SessionCursor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="{Binding RowBg}"
                                                    MouseLeftButtonUp="OnTaskRunClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                             Fill="{Binding DotBrush, Mode=OneWay}"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Result}" FontSize="12"
                                                                   Foreground="{StaticResource DimBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource RowSig}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 面板3：历史 —— 会话历史列表（可点击恢复） -->
                    <Grid x:Name="panelHistoryRoot" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>   <!-- 本会话改动卡片（列表下方固定卡，见 Grid.Row=3） -->
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="18,14,12,6">
                            <Button x:Name="btnNewSession" Content="+ 新会话" DockPanel.Dock="Right" Height="24"
                                    Style="{StaticResource AddBtn}" Padding="6,2" FontSize="10"
                                    Click="OnNewSession" Margin="0,0,6,0"
                                    IsEnabled="{Binding SwitchEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding SwitchLockTip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button x:Name="btnNewOrchestration" Content="+ 计划会话" DockPanel.Dock="Right" Height="24"
                                    Style="{StaticResource AddBtn}" Padding="6,2" FontSize="10"
                                    Click="OnNewOrchestration" Margin="0,0,6,0"
                                    IsEnabled="{Binding SwitchEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding SwitchLockTip, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue='新建计划会话：对话式收集需求 → 拆解生成任务树 → 确认后逐步自动执行'}"/>
                            <TextBlock Text="会话历史" Style="{StaticResource SecTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Grid.Row="1" Margin="18,0,18,10" Background="#1AFFFFFF" CornerRadius="8" Padding="10,5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="12"
                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="sessionSearchClear" DockPanel.Dock="Right" Text="✕" FontSize="12"
                                           Foreground="{StaticResource DimBrush}" Cursor="Hand"
                                           VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"
                                           ToolTip="清空搜索" MouseLeftButtonUp="OnSessionSearchClear"/>
                                <TextBox x:Name="sessionSearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource GreenBrush}" CaretBrush="{StaticResource GreenBrush}"
                                         FontSize="12" VerticalContentAlignment="Center" ToolTip="输入关键字后按回车查询会话，Esc 清空"
                                         KeyDown="OnSessionSearchKeyDown" TextChanged="OnSessionSearchTextChanged"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="2" x:Name="panelHistory" Style="{StaticResource HiddenScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                            <StackPanel>
                                <TreeView x:Name="sessionTree" Background="Transparent" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnSessionTreeWheel" Margin="0,0,0,4">
                                    <TreeView.Resources>
                                        <!-- 分组节点（普通会话/计划会话）：样式与架构栏分组一致 —— 📁 图标 + 粗体组名 + 计数；
                                            无左侧折叠箭头，右侧 ▾/▸ 随 IsExpanded 自动切换（DataTrigger），单击组行折叠/展开（见 OnSessionGroupHeaderClick） -->
                                        <HierarchicalDataTemplate DataType="{x:Type local:SessionGroup}" ItemsSource="{Binding Items}">
                                            <DockPanel Margin="0,5,0,5">
                                                <TextBlock x:Name="grpArrow" DockPanel.Dock="Right" Text="▾" FontSize="11"
                                                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Total, StringFormat=' ({0})'}" FontSize="10.5"
                                                               Foreground="{StaticResource DimBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <HierarchicalDataTemplate.Triggers>
                                                <!-- 折叠/展开状态驱动右侧箭头方向（与架构栏分组一致：▾=展开，▸=收起） -->
                                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="False">
                                                    <Setter TargetName="grpArrow" Property="Text" Value="▸"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                        <!-- 会话项节点：叶子，样式与原来的列表项一致 -->
                                        <DataTemplate DataType="{x:Type local:SessionItem}">
                                            <Border x:Name="rowBd" Style="{StaticResource RowBox}"
                                                    Cursor="{Binding SessionCursor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="{Binding RowBg}" Margin="0,1,0,1"
                                                    ToolTip="{Binding SwitchLockTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    MouseLeftButtonUp="OnSessionClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 标题区用 Grid（非横向 StackPanel）：StackPanel 给子项无限宽，TextTrimming 永不生效；
                                                         中间列 Width=* 受视口约束（TreeView 已禁用横向滚动），标题过长才会截断成 … -->
                                                    <Grid Grid.Column="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="stateDot" Grid.Column="0" Style="{StaticResource RowDot}" Fill="{StaticResource P2Brush}" Margin="0,0,6,0"/>
                                                        <!-- 会话列表项只允许一行：绑定单行化标题 TitleLine（已去回车/换行），NoWrap + CharacterEllipsis 过长显示 … -->
                                                        <TextBlock x:Name="titleTx" Grid.Column="1" Text="{Binding TitleLine}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        <!-- 待决策提醒圆点（0=无/1=危险/2=计划，见 PendingKind 触发器）：仅在非当前会话挂起时由 RefreshPendingBadges 置位显示。
                                                             用正圆 Ellipse（非感叹号角标），避免字体渲染导致形状不圆 -->
                                                        <Ellipse x:Name="pendBadge" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource PauseBrush}"
                                                                 Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                                 ToolTip="该会话有人工介入点挂起"/>
                                                    </Grid>
                                                    <TextBlock x:Name="timeTx" Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource RowSig}"
                                                           Visibility="{Binding ShowTimeVis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBlock x:Name="progTx" Grid.Column="1" Text="{Binding ListProgressText}" Style="{StaticResource RowSig}"
                                                               Foreground="{StaticResource AmberBrush}" FontWeight="Bold" Visibility="Collapsed"
                                                               ToolTip="当前执行进度：轮次 + 计划待办完成百分比"/>
                                                    <TextBlock x:Name="delIcon" Grid.Column="2" Text="✕" FontSize="12"
                                                               Foreground="{StaticResource DimBrush}"
                                                               Cursor="{Binding SessionCursor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Margin="6,0,2,0" VerticalAlignment="Center"
                                                               Visibility="Collapsed" ToolTip="删除此会话"
                                                               MouseLeftButtonUp="OnSessionDelete"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- 会话切换锁（发送→首个回复token，SSE流未绑定）：行禁用+置灰防流串台；hover 提示见 rowBd ToolTip 绑定 -->
                                                <DataTrigger Binding="{Binding SwitchEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                    <Setter TargetName="rowBd" Property="IsEnabled" Value="False"/>
                                                    <Setter TargetName="rowBd" Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                                <Trigger SourceName="rowBd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="delIcon" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <!-- 会话运行状态配色：1 进行中=桔点+桔字；2 等文件锁=黄；3 中断/暂停=红；4 完成=绿；0 空闲=默认蓝点白字 -->
                                                <DataTrigger Binding="{Binding RunState}" Value="1">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource AmberBrush}"/>
                                                    <Setter TargetName="titleTx" Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                    <!-- 执行中：右侧时间列切换为"轮次 + 计划进度%"（琥珀粗体）；结束自动恢复时间显示 -->
                                                    <Setter TargetName="timeTx" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="progTx" Property="Visibility" Value="Visible"/>
                                                    <!-- 执行中不显示删除按钮（悬停触发器先声明，此处后声明覆盖生效），避免误删正在运行的会话 -->
                                                    <Setter TargetName="delIcon" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="2">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource WaitBrush}"/>
                                                    <Setter TargetName="titleTx" Property="Foreground" Value="{StaticResource WaitBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="3">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource PauseBrush}"/>
                                                    <Setter TargetName="titleTx" Property="Foreground" Value="{StaticResource PauseBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunState}" Value="4">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    <Setter TargetName="titleTx" Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <!-- 计划会话（编排）圆点按子叶任务聚合状态着色：1 未完成=桔 / 2 全部成功=绿 / 3 有错误=红。
                                                     声明在 RunState 触发器之后 → 同属性冲突时计划色胜出（圆点稳定反映计划执行结果，
                                                     不再随会话运行态闪变；标题字色仍由 RunState 驱动）。PlanState=0（无计划）永不命中不干扰 -->
                                                <DataTrigger Binding="{Binding PlanState}" Value="1">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource AmberBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlanState}" Value="2">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlanState}" Value="3">
                                                    <Setter TargetName="stateDot" Property="Fill" Value="{StaticResource PauseBrush}"/>
                                                </DataTrigger>
                                                <!-- 待决策提醒圆点触发器：PendingKind=1 危险命令待裁决（红圆点）；=2 计划审批/方案待确认（桔圆点）。
                                                     仅当刷新方法按"非当前会话 + TaskRecord 挂起"置位时命中；切回/裁决/收口归 0 后自动隐藏 -->
                                                <DataTrigger Binding="{Binding PendingKind}" Value="1">
                                                    <Setter TargetName="pendBadge" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="pendBadge" Property="Fill" Value="{StaticResource PauseBrush}"/>
                                                    <Setter TargetName="pendBadge" Property="ToolTip" Value="该会话有危险命令等待你决策（切回处理）"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PendingKind}" Value="2">
                                                    <Setter TargetName="pendBadge" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="pendBadge" Property="Fill" Value="{StaticResource AmberBrush}"/>
                                                    <Setter TargetName="pendBadge" Property="ToolTip" Value="该会话有执行计划/方案等待审批（切回处理）"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                        <!-- 加载更多占位项：分组内历史超过当前展示页时挂在组尾，点击再展开一页（见 OnSessionMoreClick） -->
                                        <DataTemplate DataType="{x:Type local:SessionMoreItem}">
                                            <Border x:Name="moreBd" Margin="0,1,0,1" Padding="8,3"
                                                    Background="Transparent" MouseLeftButtonUp="OnSessionMoreClick"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <TextBlock x:Name="moreTx" Text="{Binding Hint}" FontSize="11.5"
                                                               Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="moreBd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="moreTx" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Setter TargetName="moreBd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <!-- 统一前景：分组行图标/文本默认亮色（同架构栏 ItemContainerStyle），📁 不带字体色时也显示白色 -->
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <!-- IsOpen 双向绑定：折叠/展开状态写回 SessionGroup，刷新重建后由代码恢复 -->
                                            <Setter Property="IsExpanded" Value="{Binding IsOpen, Mode=TwoWay, FallbackValue=True}"/>
                                            <EventSetter Event="Expanded" Handler="OnSessionGroupExpanded"/>
                                            <EventSetter Event="Collapsed" Handler="OnSessionGroupCollapsed"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <!-- 分组行单击切换折叠（OnSessionGroupHeaderClick 按 DataContext 类型过滤，叶子行点击由
                                                                 OnSessionClick 处理并 Handled，通常不冒泡至此）；组头无左侧箭头列，图标/名称/计数/▾
                                                                 同处一行 DockPanel，垂直中心天然对齐 -->
                                                            <Border x:Name="Bd" Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true"
                                                                    MouseLeftButtonUp="OnSessionGroupHeaderClick">
                                                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="False">
                                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                <TextBlock x:Name="sessionEmpty" Text="（暂无会话记录）" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="6,8" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ============ 本会话改动卡片（会话列表下方固定卡）：点哪个会话就随动显示它累计改过哪些文件。
                             DataContext 由代码在切会话/收口/历史还原时指向当前 SessionItem（RefreshChangedCard），
                             计数、清单、折叠状态全走 SessionItem 绑定；无当前会话时绑定失败 → FallbackValue 收起整卡。
                             清单行复用 ChangedFileVm 隐式模板（状态标记 + 文件名 + 目录 + 时间），单击行在代码查看器打开该文件；
                             无改动记录（存量历史会话 / 纯问答会话）→ ChangedCardVisible=Collapsed，不挤占会话列表空间。 ============ -->
                        <Border x:Name="sessionChangedCard" Grid.Row="3" Margin="18,2,18,12" Padding="10,7"
                                Background="#1AFFFFFF" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Visibility="{Binding ChangedCardVisible, FallbackValue=Collapsed}">
                            <StackPanel>
                                <!-- 标题行：📄 + 计数文本 + 右侧 ▾/▸，整行可点切换清单展开 -->
                                <Border Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnChangedCardToggle"
                                        ToolTip="本会话累计改动的文件（点击展开/收起）">
                                    <DockPanel Margin="2,1">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ChangedArrow}" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="会话文件变动" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ChangedCountText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- 文件清单：内部滚动限高（约 8 行），条目再多也不把会话列表挤没 -->
                                <ScrollViewer MaxHeight="180" Style="{StaticResource HiddenScrollViewer}"
                                              VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"
                                              Visibility="{Binding ChangedListVisible}">
                                    <ItemsControl ItemsSource="{Binding ChangedFiles}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 面板4：技能 —— 可管理列表（启用/禁用 + 注入） -->
                    <Grid x:Name="panelSkillRoot" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="18,14,12,10">
                            <!-- 本地 / 市场 视图切换（深色分段胶囊；市场：浏览外部目录册，搜索安装技能与插件） -->
                            <Border DockPanel.Dock="Right" Background="#00000066" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    VerticalAlignment="Center" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="skillViewLocal" Content="本地" Margin="0,0,2,0"
                                            Style="{StaticResource SkillViewBtn}" Tag="cur"
                                            Click="OnSkillViewClick"/>
                                    <Button x:Name="skillViewMarket" Content="市场"
                                            Style="{StaticResource SkillViewBtn}"
                                            Click="OnSkillViewClick"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" x:Name="panelSkill" Style="{StaticResource HiddenScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                            <StackPanel>
                                <!-- Agent 管理 -->
                                <Expander Style="{StaticResource SkillExpander}" IsExpanded="True"
                                          Header="Agent 管理">
                                <StackPanel Margin="0,4,0,0">
                                    <Border Style="{StaticResource RowBox}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"><Ellipse Style="{StaticResource RowDot}"/><TextBlock Text="主 Agent"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="50 轮循环" Style="{StaticResource RowSig}"/></Grid></Border>
                                    <Border Style="{StaticResource RowBox}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"><Ellipse Style="{StaticResource RowDot}" Fill="{StaticResource P1Brush}"/><TextBlock Text="子 Agent · 代码审查"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="只读" Style="{StaticResource RowSig}"/></Grid></Border>
                                </StackPanel>
                            </Expander>

                            <!-- 内置工具 -->
                            <Expander Style="{StaticResource SkillExpander}" IsExpanded="False" Margin="0,6,0,0"
                                      Header="内置工具">
                                <ItemsControl x:Name="builtinToolList" Margin="0,4,0,0"
                                              ContextMenuOpening="OnToolMenuOpening"
                                              PreviewMouseRightButtonDown="OnToolRightDown">
                                    <ItemsControl.ContextMenu>
                                        <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                            <MenuItem x:Name="toolAddToSession" Header="加入到会话" Foreground="#DDDDE4" Click="OnToolAddToSession"/>
                                        </ContextMenu>
                                    </ItemsControl.ContextMenu>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:ToolItemDef}">
                                            <Border Style="{StaticResource RowBox}" Cursor="Hand"
                                                    MouseLeftButtonUp="OnToolItemClick">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource RowDot}" 
                                                                 Fill="{Binding StatusBrush}" 
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" 
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                                               Style="{StaticResource RowSig}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- 内置技能 -->
                            <Expander Style="{StaticResource SkillExpander}" IsExpanded="True" Margin="0,6,0,0"
                                      Header="内置技能">
                                <ItemsControl x:Name="builtinSkillList" Margin="0,4,0,0"
                                              ContextMenuOpening="OnSkillMenuOpening"
                                              PreviewMouseRightButtonDown="OnSkillRightDown">
                                    <ItemsControl.ContextMenu>
                                        <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                            <MenuItem x:Name="builtinSkillAddToSession" Header="加入到会话" Foreground="#DDDDE4" Click="OnSkillAddToSession"/>
                                        </ContextMenu>
                                    </ItemsControl.ContextMenu>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:SkillDef}">
                                            <Border Style="{StaticResource RowBox}" Cursor="Hand"
                                                    MouseLeftButtonUp="OnSkillItemClick">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ItemTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8B90A8" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#D8D8E8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Preconditions}" FontSize="10.5" Foreground="#8B90A8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource RowDot}" 
                                                                 Fill="{Binding Enabled, Converter={StaticResource BoolToBrush}}" 
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" 
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                                               Style="{StaticResource RowSig}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- 声明式插件 -->
                            <Expander Style="{StaticResource SkillExpander}" IsExpanded="True" Margin="0,6,0,0"
                                      Header="声明式插件">
                                <ItemsControl x:Name="pluginList" Margin="0,4,0,0"
                                              ContextMenuOpening="OnPluginMenuOpening"
                                              PreviewMouseRightButtonDown="OnPluginRightDown">
                                    <ItemsControl.ContextMenu>
                                        <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                            <MenuItem x:Name="pluginAddToSession" Header="加入到会话" Foreground="#DDDDE4" Click="OnPluginAddToSession"/>
                                        </ContextMenu>
                                    </ItemsControl.ContextMenu>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:PluginDef}">
                                            <Border Style="{StaticResource RowBox}" Cursor="Hand"
                                                    MouseLeftButtonUp="OnPluginItemClick">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ItemTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8B90A8" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#D8D8E8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Preconditions}" FontSize="10.5" Foreground="#8B90A8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource RowDot}" 
                                                                 Fill="{Binding StatusBrush}" 
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" 
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                                               Style="{StaticResource RowSig}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <!-- Skill 库 -->
                            <Expander Style="{StaticResource SkillExpander}" IsExpanded="True" Margin="0,6,0,0"
                                      Header="Skill 库">
                                <ItemsControl x:Name="skillList" Margin="0,4,0,0"
                                              ContextMenuOpening="OnSkillMenuOpening"
                                              PreviewMouseRightButtonDown="OnSkillRightDown">
                                    <ItemsControl.ContextMenu>
                                        <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                            <MenuItem x:Name="skillAddToSession" Header="加入到会话" Foreground="#DDDDE4" Click="OnSkillAddToSession"/>
                                        </ContextMenu>
                                    </ItemsControl.ContextMenu>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:SkillDef}">
                                            <Border Style="{StaticResource RowBox}" Cursor="Hand"
                                                    MouseLeftButtonUp="OnSkillItemClick">
                                                <Border.ToolTip>
                                                    <ToolTip Style="{StaticResource ItemTip}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF"/>
                                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8B90A8" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#D8D8E8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Preconditions}" FontSize="10.5" Foreground="#8B90A8"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource RowDot}" 
                                                                 Fill="{Binding Enabled, Converter={StaticResource BoolToBrush}}" 
                                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NameDisplay}" FontSize="12.5" 
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                                               Style="{StaticResource RowSig}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 市场视图：三栏折叠（已安装 / 在线热度排行 / 在线搜索结果），与本地列表同页切换 -->
                    <Grid Grid.Row="1" x:Name="panelMarket" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 搜索栏 -->
                            <RowDefinition Height="*"/>      <!-- 三栏折叠区 -->
                            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="18,4,18,10" Background="#1AFFFFFF" CornerRadius="8" Padding="10,6">
                            <DockPanel>
                                <!-- 搜索/刷新按钮：搜索框空=刷新列表（强制重载三栏），有内容=搜索市场（在线聚合搜索）；文本随输入切换 -->
                                <Button DockPanel.Dock="Right" x:Name="marketGitHubBtn" Content="刷新列表" Height="26"
                                        Style="{StaticResource MarketSearchBtn}"
                                        FontSize="11.5" Padding="9,0" Margin="6,0,0,0" Click="OnMarketSearchBtnClick"
                                        ToolTip="搜索框为空时强制刷新已安装/热度榜/结果栏；输入关键字后变为“搜索市场”，按关键字同时搜索 ClawHub / GitHub / Gitee（Gitee 需配置 [Market] GiteeToken），输入框回车也可触发"/>
                                <TextBox x:Name="marketSearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                         FontSize="12.5" VerticalContentAlignment="Center"
                                         TextChanged="OnMarketSearchBoxTextChanged" KeyDown="OnMarketSearchKeyDown"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Style="{StaticResource HiddenScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" Padding="12,0,12,8">
                            <StackPanel>
                                <!-- 加载中提示（拉取期间显示） -->
                                <TextBlock x:Name="marketLoading" Text="正在拉取市场数据…" FontSize="12"
                                           Foreground="{StaticResource DimBrush}" Margin="10,14,0,0"
                                           Visibility="Collapsed"/>
                                <!-- 无结果提示（三栏全空时） -->
                                <TextBlock x:Name="marketEmpty" Text="暂无数据：点“在线搜索”或右上角 ↻ 刷新" FontSize="12"
                                           Foreground="{StaticResource DimBrush}" Margin="10,14,0,0"
                                           Visibility="Collapsed"/>

                                <!-- 栏1：已安装（来自市场的技能/插件，可一键卸载） -->
                                <Expander x:Name="marketInstalledExp" Style="{StaticResource SkillExpander}"
                                          Header="已安装（来自市场）" IsExpanded="True" Margin="0,0,0,10">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl x:Name="marketInstalledList" ItemTemplate="{StaticResource MarketCard}"
                                                      ContextMenuOpening="OnMarketMenuOpening"
                                                      PreviewMouseRightButtonDown="OnMarketRightDown">
                                            <ItemsControl.ContextMenu>
                                                <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                                    <MenuItem x:Name="marketInstalledAddToSession" Header="加入到会话" Foreground="#DDDDE4" Click="OnMarketAddToSession"/>
                                                </ContextMenu>
                                            </ItemsControl.ContextMenu>
                                        </ItemsControl>
                                        <TextBlock x:Name="marketInstalledEmpty" Text="还没有从市场安装的条目" FontSize="12"
                                                   Foreground="{StaticResource DimBrush}" Margin="10,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- 栏2：在线热度排行（ClawHub 下载榜，引导安装） -->
                                <Expander x:Name="marketTrendingExp" Style="{StaticResource SkillExpander}"
                                          Header="在线市场热度排行" IsExpanded="True" Margin="0,0,0,10">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl x:Name="marketTrendingList" ItemTemplate="{StaticResource MarketCard}"
                                                      ContextMenuOpening="OnMarketMenuOpening"
                                                      PreviewMouseRightButtonDown="OnMarketRightDown">
                                            <ItemsControl.ContextMenu>
                                                <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                                    <MenuItem Header="加入到会话" Foreground="#DDDDE4" Click="OnMarketAddToSession"/>
                                                </ContextMenu>
                                            </ItemsControl.ContextMenu>
                                        </ItemsControl>
                                        <TextBlock x:Name="marketTrendingEmpty" Text="暂无排行数据（网络不可达或未刷新）" FontSize="12"
                                                   Foreground="{StaticResource DimBrush}" Margin="10,6,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <!-- 栏3：在线搜索结果（多源合并，未搜索时不显示） -->
                                <Expander x:Name="marketResultExp" Style="{StaticResource SkillExpander}"
                                          Header="在线搜索结果" IsExpanded="True" Visibility="Collapsed" Margin="0,0,0,10">
                                    <StackPanel Margin="0,4,0,0">
                                        <ItemsControl x:Name="marketResultList" ItemTemplate="{StaticResource MarketCard}"
                                                      ContextMenuOpening="OnMarketMenuOpening"
                                                      PreviewMouseRightButtonDown="OnMarketRightDown">
                                            <ItemsControl.ContextMenu>
                                                <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                                    <MenuItem Header="加入到会话" Foreground="#DDDDE4" Click="OnMarketAddToSession"/>
                                                </ContextMenu>
                                            </ItemsControl.ContextMenu>
                                        </ItemsControl>
                                        <TextBlock x:Name="marketResultEmpty" Text="没有匹配的条目" FontSize="12"
                                                   Foreground="{StaticResource DimBrush}" Margin="10,6,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" x:Name="marketStatus" FontSize="11" Foreground="{StaticResource DimBrush}"
                                   Margin="18,2,18,10" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    </Grid>

                    <!-- 面板5：架构（功能架构树：L0=项目 → L1=子系统 → L2..Ln=功能分类 → 叶子=最小独立功能；
                         数据来源 {项目根}/.gairr/architecture.json，进入页签时加载） -->
                    <Grid x:Name="panelArchRoot" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="archStats" Margin="18,14,12,10" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" Text="功能架构"/>
                        <TreeView Grid.Row="1" x:Name="treeArch" Background="Transparent" BorderThickness="0"
                                  Padding="12,0,12,14"
                                  ContextMenuOpening="OnArchMenuOpening"
                                  MouseDoubleClick="OnArchNodeDoubleClick">
                                <TreeView.ContextMenu>
                                    <ContextMenu Opened="OnArchMenuOpened">
                                        <!-- 功能架构节点 -->
                                        <MenuItem x:Name="menuArchUpdate" Header="更新架构树"
                                                  Click="OnArchUpdate"/>
                                        <Separator x:Name="menuArchSep1"/>
                                        <!-- 功能叶子：新建编排任务（L0 目标 = 节点名+路径） -->
                                        <MenuItem x:Name="menuArchCreateOrchestration"
                                                  Header="在此功能新建编排任务"
                                                  Click="OnArchCreateOrchestration"/>
                                        <Separator x:Name="menuArchSep2"/>
                                        <!-- 编排根执行控制（Kind=plan 节点命中时启用） -->
                                        <MenuItem x:Name="menuArchPlanStart" Header="开始执行"
                                                  Click="OnPlanStartClick"/>
                                        <MenuItem x:Name="menuArchPlanPause" Header="暂停"
                                                  Click="OnPlanPauseClick"/>
                                        <MenuItem x:Name="menuArchPlanResume" Header="继续"
                                                  Click="OnPlanResumeClick"/>
                                        <MenuItem x:Name="menuArchPlanStop" Header="停止"
                                                  Click="OnPlanStopClick"/>
                                        <Separator x:Name="menuArchSep3"/>
                                        <MenuItem x:Name="menuArchPlanPass" Header="标记通过"
                                                  Click="OnPlanPassClick"/>
                                        <MenuItem x:Name="menuArchPlanSkip" Header="标记跳过"
                                                  Click="OnPlanSkipClick"/>
                                        <Separator x:Name="menuArchSep4"/>
                                        <MenuItem x:Name="menuArchPlanDelete" Header="删除编排视图（保留数据）"
                                                  Click="OnArchPlanDelete"/>
                                        <Separator x:Name="menuArchSep5"/>
                                        <MenuItem x:Name="menuArchViewLeafSession" Header="查看叶子会话历史"
                                                  Click="OnViewLeafSessionClick"/>
                                        <!-- 以上按分隔线划为 6 段（更新/新建/执行/判定/删除/叶子会话）；分隔线命名后，
                                             打开时（OnArchMenuOpened 尾部）仅当紧邻两段都含可见项才显示，整段隐藏不残留 -->
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="Transparent">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageUpCommand">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                            <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.PageDownCommand">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                            <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>
                                                            </Track.IncreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border Background="#33FFFFFF" CornerRadius="2"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ArchExpandToggle" TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Width" Value="16"/>
                                        <Setter Property="Height" Value="16"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Width="16" Height="16" Padding="4,4,4,4">
                                                        <Path x:Name="ExpandPath" Fill="Transparent" Stroke="#8888A0" StrokeThickness="1.5"
                                                              StrokeLineJoin="Round"
                                                              Data="M 1 0 L 5 4 L 1 8"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ExpandPath" Property="Data" Value="M 0 1 L 4 5 L 8 1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsOpen, Mode=TwoWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <EventSetter Event="Expanded" Handler="OnArchNodeExpanded"/>
                                        <EventSetter Event="Collapsed" Handler="OnArchNodeCollapsed"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <StackPanel>
                                                        <Grid Margin="{Binding Indent, Mode=OneTime}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" x:Name="ExpanderCol"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                          Style="{StaticResource ArchExpandToggle}"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                            <Border x:Name="SelBg" Grid.Column="1" Background="Transparent"
                                                                    CornerRadius="4">
                                                                <ContentPresenter ContentSource="Header"
                                                                                  HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                        <!-- 分组节点：隐藏左侧箭头并收回列宽，避免 16px 空白浪费 -->
                                                        <DataTrigger Binding="{Binding Kind}" Value="group">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="ExpanderCol" Property="Width" Value="0"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelBg" Property="Background" Value="#151520"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <DockPanel Margin="2,3" ToolTip="{Binding Tip}">
                                            <!-- 分组节点右侧箭头 -->
                                            <TextBlock x:Name="grpArrow" DockPanel.Dock="Right"
                                                       Text="▾" FontSize="11" Foreground="{StaticResource DimBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Visibility="Collapsed"/>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 分组节点：📁 图标 + 粗体；普通节点：圆点 -->
                                                <TextBlock x:Name="grpIcon" Text="📁" FontSize="12"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"
                                                           Visibility="Collapsed"/>
                                                <Ellipse x:Name="dotIcon" Width="7" Height="7" Fill="{Binding DotBrush}"
                                                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="nodeName" Text="{Binding Name}" FontSize="12.5"
                                                           Foreground="{Binding NameBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="group">
                                                <Setter TargetName="grpArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="grpIcon" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="dotIcon" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="nodeName" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="nodeName" Property="FontSize" Value="13"/>
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ 拖拽分割条 ============ -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      Background="Transparent" Cursor="SizeWE"
                      ShowsPreview="False"/>

        <!-- ============ 对话区 ============ -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部动态信息栏：滚动后视口内看不到 GAIRR 头像/用户头像时，
                 把 GAIRR 名称+Steps 或用户最后一次问题固定显示在此（平时隐藏）。
                 行序恒为 L1 头像行 → L2 orcTopBar（计划进度）→ L3 orcTopLeaf（叶子状态）→
                 L4 todoBar（任务计划卡）→ L5 topSteps（锚点 Steps/占位），各行有内容才显示 -->
            <Border x:Name="chatTopBar" Grid.Row="0" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                    Padding="12" Visibility="Collapsed">
                <DockPanel>
                    <!-- 用户段（右侧）：最近滚出视口的多条用户问题竖排展示，整段底部对齐；每条气泡宽度上限为会话区 50%
                         （内容短时自适应收窄、不强制折行），长内容折行、最多 3 行，
                         条数由代码按"左侧 GAIRR 信息项高度"预算从最新一条往上追加（放不下即止）。
                         MaxHeight/ClipToBounds 由代码按该预算设置：栏高只由左侧决定，右侧永不撑高信息栏。
                         头像固定最右底部与最新一条对齐；每条气泡悬停看全文 -->
                    <DockPanel DockPanel.Dock="Right" x:Name="topUserSec"
                               Visibility="Collapsed" VerticalAlignment="Bottom" Margin="20,0,0,0" ClipToBounds="True">
                        <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="7" Background="{StaticResource P1Brush}"
                                VerticalAlignment="Bottom" Margin="8,0,0,0">
                            <TextBlock Text="你" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="topUserStack" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <!-- Agent 段：最新 Agent 消息头像滚出视口时显示头像/名称/状态/Steps。
                         点击 L1 头像/名称行（不含 L2~L5 各行）→ 消息流滚回最底部 -->
                    <StackPanel x:Name="topAgentSec" Visibility="Collapsed"
                                VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <!-- VerticalAlignment="Top"：计划卡多行撑高顶栏时，头像与计划卡顶部对齐，不居中 -->
                            <Border x:Name="topLogo" Width="30" Height="30" CornerRadius="8" Background="{StaticResource GradAv}"
                                    VerticalAlignment="Top" Cursor="Hand"
                                    PreviewMouseLeftButtonUp="OnTopAgentClick">
                                <!-- FontSize=16：顶栏 GAIRR logo 的 G 字符与消息流头像保持一致放大 -->
                                <TextBlock Text="G" Foreground="White" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Cursor="Hand"
                                            PreviewMouseLeftButtonUp="OnTopAgentClick">
                                    <TextBlock Text="GAIRR Agent" FontSize="13" FontWeight="Bold"/>
                                    <!-- 在线状态圆点与 · v0.2.0 版本号已按需求移除；mStatus 仅保留给临时提示
                                         （git 提交收纳、操作被拦截等），常态为空即不占位、不显示 -->
                                    <TextBlock x:Name="mStatus" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <!-- P：当前会话参数标题行：小字同步显示 角色+模式+模型（随会话切换/会话内修改实时刷新），悬停见完整"概尔 Agent · …" -->
                                <TextBlock x:Name="topPinLine" FontSize="11" Foreground="{StaticResource DimBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,1,0,0"
                                           Visibility="Collapsed"/>
                                <!-- L2/L3：编排执行常驻行（需求：执行计划+进度+用时同步顶部 / 叶子执行/审查/暂停）。
                                     执行编排期间 chatTopBar 整体常驻不随滚动隐藏；叶子行在审核阶段切琥珀提示。
                                     有内容才显示，空则整行隐藏不占位 -->
                                <TextBlock x:Name="orcTopBar" FontSize="11" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,2,0,0"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="orcTopLeaf" FontSize="11" Foreground="{StaticResource DimBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620" Margin="0,1,0,0"
                                           Visibility="Collapsed"/>
                                <!-- L4：任务计划卡（随信息栏按头像可见性自动显隐；多行展示全部步骤完成状态） -->
                                <TextBlock x:Name="todoBar" FontSize="11" Foreground="{StaticResource AmberBrush}"
                                           TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,0"
                                           Visibility="Collapsed" Cursor="Hand" PreviewMouseLeftButtonUp="OnTodoBarClick"/>
                                <!-- L5：锚点消息 Steps（有锚点显锚点 Steps；编排执行且上方无锚点时显示占位提示）。
                                     与 L4 同列、与 L4 字符左对齐（不独立成行、不贴顶栏左缘），点击跳到该轮完成信息条 -->
                                <TextBlock x:Name="topSteps" FontSize="11" Foreground="{StaticResource GreenBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="460" Margin="0,2,0,0"
                                           Cursor="Hand" PreviewMouseLeftButtonUp="OnTopStepsClick"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 消息流（编排会话时右列显示编排信息面板，左列对话区保持不变） -->
            <Grid x:Name="msgGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="orcSplitCol" Width="Auto"/>   <!-- 编排右栏拖把专用列：面板收起时拖把 Collapsed，此列自动归零 -->
                    <ColumnDefinition x:Name="orcCol" Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="msgScroll" Grid.Column="0" Style="{StaticResource HiddenScrollViewer}"
                              VerticalScrollBarVisibility="Auto" Padding="12,12,12,12"
                              CanContentScroll="False">
                    <ItemsControl x:Name="msgList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <!-- 分段加载提示：用户向上滚动到顶、正在装配更早消息时浮现在对话区顶部（默认折叠；
                     IsHitTestVisible=False：不吃滚轮/点击，滚动手感不受影响） -->
                <Border x:Name="olderLoadingBar" Grid.Column="0" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10" Padding="12,5" IsHitTestVisible="False">
                    <TextBlock Text="⏳ 正在加载更早的消息…" FontSize="12" Foreground="{StaticResource DimBrush}"/>
                </Border>
                <!-- 编排会话信息面板（双 Tab：编排方案 / 编排执行） -->
                <Border x:Name="orcPanel" Grid.Column="2" Margin="0,6,10,10"
                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="10" Padding="12" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Tab 切换条（无编排计划时隐藏） -->
                        <Border x:Name="orcTabBar" DockPanel.Dock="Top" Background="#00000066" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                Padding="3" Margin="0,0,0,8">
                            <!-- 页签条撑满面板整行：左=页签组（编排执行/方案 + 代码查看），右=关闭 ✕（代码查看打开时右上角常驻） -->
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="orcTabExec" Content="编排执行" Tag="cur"
                                            Style="{StaticResource SkillViewBtn}" Click="OnOrcTabClick"/>
                                    <Button x:Name="orcTabPlan" Content="编排方案" Margin="2,0,0,0"
                                            Style="{StaticResource SkillViewBtn}" Click="OnOrcTabClick"/>
                                    <Button x:Name="orcTabCode" Content="代码查看" Margin="2,0,0,0" Visibility="Collapsed"
                                            Style="{StaticResource SkillViewBtn}" Click="OnOrcTabClick"/>
                                    <Button x:Name="orcTabCtx" Content="请求上下文" Margin="2,0,0,0" Visibility="Collapsed"
                                            Style="{StaticResource SkillViewBtn}" Click="OnOrcTabClick"/>
                                    <!-- 提交详情已浮层化（双击左树 git 变更文件贴树浮出），不再占用右侧页签 -->
                                </StackPanel>
                                <Button x:Name="codeTabClose" DockPanel.Dock="Right" Content="✕" Click="OnCodeViewClose"
                                        Style="{StaticResource CodeTabCloseBtn}"
                                        FontSize="11" Padding="6,1" Margin="12,0,2,0"
                                        Foreground="{StaticResource DimBrush}"
                                        ToolTip="关闭代码查看" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- 内容宿主：Tab1 编排方案 / Tab2 编排执行树 互斥可见共用同一区域（DockPanel 唯一填充子元素） -->
                        <Grid>
                            <!-- Tab1: 编排方案：头部信息 Auto 高 + doc.md 预览占满剩余高度（超高在预览区内滚动，滚轮悬停即可用） -->
                            <Grid x:Name="orcPlanContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="编排会话" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Ellipse x:Name="orcPhaseDot" Width="8" Height="8" Fill="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="orcPhaseText" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="orcTitle" FontSize="12" FontWeight="Bold" Margin="0,10,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="L0 目标" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,10,0,2"/>
                                    <TextBlock x:Name="orcGoal" FontSize="12" Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="编排文档 doc.md（随生成更新）" FontSize="12" Foreground="{StaticResource DimBrush}" Margin="0,12,0,6"/>
                                </StackPanel>
                                <!-- 文档预览：向右负边距吃掉面板右侧留白（滚动条贴面板右边框，不留空隙） -->
                                <RichTextBox x:Name="orcDocPreview" Grid.Row="1" FontFamily="Consolas" FontSize="12"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,-12,0"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}">
                                    <!-- 文档区滚动条：窄深色（RichTextBox 模板内 ScrollViewer 的滚动条会命中此隐式样式） -->
                                    <RichTextBox.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Width" Value="4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollBar">
                                                        <Grid Background="Transparent">
                                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Background="Transparent"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Background="Transparent"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb>
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Border CornerRadius="2" Background="#2A2A3A"/>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RichTextBox.Resources>
                                </RichTextBox>
                            </Grid>

                        <!-- Tab2: 编排执行树 -->
                        <TreeView x:Name="treeOrchExec" Background="Transparent" BorderThickness="0"
                                  Visibility="Collapsed"
                                  VirtualizingStackPanel.IsVirtualizing="False"
                                  ContextMenuOpening="OnOrchExecMenuOpening"
                                  MouseDoubleClick="OnArchNodeDoubleClick">
                            <TreeView.ContextMenu>
                                <ContextMenu Opened="OnOrchExecMenuOpened">
                                    <MenuItem x:Name="menuOrchPlanRepair" Header="复核编排树（自动修复）" Click="OnPlanRepairClick"/>
 <MenuItem x:Name="menuOrchPlanRelink" Header="重新关联架构节点…" Click="OnPlanRelinkClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="menuOrchPlanStart" Header="开始执行" Click="OnPlanStartClick"/>
                                    <MenuItem x:Name="menuOrchPlanResume" Header="继续" Click="OnPlanResumeClick"/>
                                    <MenuItem x:Name="menuOrchPlanStop" Header="停止" Click="OnPlanStopClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="menuOrchPlanPass" Header="标记通过" Click="OnPlanPassClick"/>
                                    <MenuItem x:Name="menuOrchPlanSkip" Header="标记跳过" Click="OnPlanSkipClick"/>
                                    <MenuItem x:Name="menuOrchPlanUndo" Header="撤销标记（恢复为待执行）" Click="OnPlanUndoClick"/>
                                    <Separator/>
                                    <MenuItem x:Name="menuOrchPlanDelete" Header="删除所选分支（含子叶）" Click="OnPlanDeleteBranch"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <!-- 编排执行树折叠箭头（与架构树同款） -->
                                <Style x:Key="ArchExpandToggle" TargetType="ToggleButton">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Width" Value="16"/>
                                    <Setter Property="Height" Value="16"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Path Data="M5,3 L11,8 L5,13" Stroke="{StaticResource DimBrush}"
                                                      StrokeThickness="1.3" Fill="Transparent"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="False">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="rot" Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="rot"
                                                                        Storyboard.TargetProperty="Angle"
                                                                        From="0" To="90" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="rot"
                                                                        Storyboard.TargetProperty="Angle"
                                                                        From="90" To="0" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageUpCommand">
                                                                <RepeatButton.Template>
                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </RepeatButton.Template>
                                                            </RepeatButton>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageDownCommand">
                                                                <RepeatButton.Template>
                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </RepeatButton.Template>
                                                            </RepeatButton>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#33FFFFFF" CornerRadius="2"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsOpen, Mode=TwoWay}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Grid Margin="{Binding Indent, Mode=OneTime}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" x:Name="ExpanderCol"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                      Style="{StaticResource ArchExpandToggle}"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <Border x:Name="SelBg" Grid.Column="1" Background="Transparent" CornerRadius="4">
                                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                    <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="group">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="ExpanderCol" Property="Width" Value="0"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <!-- 选中背景：面板背景 CardBrush(#14151F) 上 #151520 几乎同色不可见，改用偏亮蓝灰 -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelBg" Property="Background" Value="#26304E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <DockPanel Margin="2,3" ToolTip="{Binding Tip}">
                                        <TextBlock x:Name="grpArrow" DockPanel.Dock="Right"
                                                   Text="▾" FontSize="11" Foreground="{StaticResource DimBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,4,0" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="grpIcon" Text="📁" FontSize="12"
                                                       Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Ellipse x:Name="dotIcon" Width="7" Height="7" Fill="{Binding DotBrush}"
                                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="nodeName" Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{Binding NameBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                       Foreground="{StaticResource DimBrush}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusSuffix}" FontSize="10.5"
                                                       Foreground="{Binding StatusSuffixBrush}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="group">
                                            <Setter TargetName="grpArrow" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="grpIcon" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="dotIcon" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="nodeName" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="nodeName" Property="FontSize" Value="13"/>
                                        </DataTrigger>
                                        <!-- 当前执行中的叶子：桔色粗体高亮（与 DotBrush 同色系）；审查中同色不加粗 -->
                                        <DataTrigger Binding="{Binding Status}" Value="running">
                                            <Setter TargetName="nodeName" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="nodeName" Property="Foreground" Value="#F5B955"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="reviewing">
                                            <Setter TargetName="nodeName" Property="Foreground" Value="#F5B955"/>
                                        </DataTrigger>
                                        <!-- 未执行（pending）：圆点灰 + 文字灰 -->
                                        <DataTrigger Binding="{Binding Status}" Value="pending">
                                            <Setter TargetName="nodeName" Property="Foreground" Value="{StaticResource DimBrush}"/>
                                        </DataTrigger>
                                        <!-- 通过：绿色；跳过：灰色+删除线；失败：红色 -->
                                        <DataTrigger Binding="{Binding Status}" Value="passed">
                                            <Setter TargetName="nodeName" Property="Foreground" Value="#3DDC97"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="skipped">
                                            <Setter TargetName="nodeName" Property="Foreground" Value="#6B7088"/>
                                            <Setter TargetName="nodeName" Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="failed">
                                            <Setter TargetName="nodeName" Property="Foreground" Value="#E53E3E"/>
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Tab3: 代码查看器（读文件工具卡点“查看代码”打开：快照/磁盘/Git 源码 + 行号 + 读取段自动定位突显） -->
                        <Grid x:Name="orcCodeContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 头部：路径 + 编辑工具栏（编辑/保存/载入磁盘当前）；关闭 ✕ 已移至页签行右端（codeTabClose，面板右上角） -->
                            <DockPanel Grid.Row="0">
                                <DockPanel.Resources>
                                    <!-- 代码页小工具栏按钮公共样式（底色/前景色由各按钮内联覆盖） -->
                                    <Style x:Key="CodeBarBtn" TargetType="Button">
                                        <Setter Property="FontSize" Value="10.5"/>
                                        <Setter Property="Padding" Value="7,2"/>
                                        <Setter Property="Margin" Value="6,0,0,0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <!-- 自定义模板：深色半透明底按钮悬浮时叠白罩提亮而不换成系统浅底（内联 Background 由 TemplateBinding 透传） -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Border x:Name="hov" Background="Transparent" CornerRadius="5"/>
                                                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="hov" Property="Background" Value="#30FFFFFF"/>
                                                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="hov" Property="Background" Value="#46FFFFFF"/>
                                                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DockPanel.Resources>
                                <!-- 关闭 ✕ 已上移页签行右端（codeTabClose）：此处不再重复放置 -->
                                <Button x:Name="codeSaveBtn" DockPanel.Dock="Right" Style="{StaticResource CodeBarBtn}"
                                        Visibility="Collapsed" Content="💾 保存" Click="OnCodeSaveClick"
                                        Background="#333DDC97" Foreground="#C9F2DF" ToolTip="保存到磁盘（原文件自动备份到 back/，可回滚）"/>
                                <Button x:Name="codeEditBtn" DockPanel.Dock="Right" Style="{StaticResource CodeBarBtn}"
                                        Content="✎ 编辑" Click="OnCodeEditClick"
                                        Background="#335C8AE6" Foreground="#BBD4FF"
                                        ToolTip="进入编辑模式（任务运行中/超大截断文件禁止）；编辑中点击 = 放弃未保存修改退出"/>
                                <Button x:Name="codeUseDiskBtn" DockPanel.Dock="Right" Style="{StaticResource CodeBarBtn}"
                                        Visibility="Collapsed" Content="⤓ 磁盘当前" Click="OnCodeUseDiskClick"
                                        Background="#26F5B955" Foreground="#FFE2A8"
                                        ToolTip="所看内容与磁盘当前不一致：载入磁盘当前版本并直接进入编辑"/>
                                <!-- 改动对比切换钮：仅从「会话文件变动」行打开且取到基线时显示，在 diff 着色视图与文件全文视图间来回切 -->
                                <Button x:Name="codeDiffBtn" DockPanel.Dock="Right" Style="{StaticResource CodeBarBtn}"
                                        Visibility="Collapsed" Content="◧ 改动对比" Click="OnCodeDiffClick"
                                        Background="#33F5B955" Foreground="#FFE2A8"
                                        ToolTip="本会话对该文件的改动：增行绿底 / 删行红底 / 双列行号 ⇄ 文件全文"/>
                                <TextBlock x:Name="codeTitle" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <!-- 来源徽标 + 读取行段 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Border x:Name="codeSrcTag" Background="#26F5B955" CornerRadius="4" Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="codeSrcText" FontSize="10" Foreground="#F5B955"/>
                                </Border>
                                <TextBlock x:Name="codeRange" FontSize="10.5" Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 代码区：AvalonEdit 编辑器（查看=只读；读取段 startLine..endLine 由代码侧渲染器画淡黄底+金色左缘突显） -->
                            <avalonEdit:TextEditor x:Name="codeEdit" Grid.Row="2" Margin="0,8,0,0"
                                                   FontFamily="Consolas" FontSize="12"
                                                   ShowLineNumbers="True"
                                                   LineNumbersForeground="{StaticResource DimBrush}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Background="{StaticResource BgBrush}"
                                                   IsReadOnly="True"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   TextChanged="OnCodeEditTextChanged">
                                <!-- 代码区滚动条：窄深色（TextEditor 内部 ScrollViewer 的滚动条会命中此 BasedOn 隐式样式；横向条同样压窄） -->
                                <avalonEdit:TextEditor.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NarrowScroll}"/>
                                </avalonEdit:TextEditor.Resources>
                            </avalonEdit:TextEditor>
                            <!-- Markdown 格式化预览：.md 文件默认走此视图（代码/文档类文件仍用上方 AvalonEdit 纯文本；
                                 两视图可见性由 ApplyCodeMdLayout 按 codeMdPreview/codeEditing 统一切换） -->
                            <FlowDocumentScrollViewer x:Name="codeMdView" Grid.Row="2" Margin="0,8,0,0"
                                                      Visibility="Collapsed" IsSelectionEnabled="True"
                                                      FontSize="13" FontFamily="Microsoft YaHei, SimSun, Segoe UI"
                                                      Background="{StaticResource BgBrush}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                <FlowDocumentScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NarrowScroll}"/>
                                </FlowDocumentScrollViewer.Resources>
                            </FlowDocumentScrollViewer>
                        </Grid>

                        <!-- Tab4: 请求上下文查看器（思考卡“上下文”打开：data/rounds/&lt;会话&gt;/roundN.json 请求快照
                             + 同基名 roundN-resp.json 回应快照；头部右侧子页切换「请求上下文 | 回应内容」，
                             只读复盘该轮“发给模型看了什么”与“模型答了什么”） -->
                        <Grid x:Name="orcCtxContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <!-- 子页切换（二选一，Tag=cur 高亮）：与顶层页签同款样式但小一档（字号 11/内边距 9,2）体现层级；
                                     共用同一头部、✕ 关闭钮、半宽规则；两页文本在打开时一次性后台载入缓存，来回切页不重新读盘 -->
                                <Button x:Name="ctxSubResp" DockPanel.Dock="Right" Content="回应内容"
                                        Style="{StaticResource SkillViewBtn}" FontSize="11" Padding="9,2"
                                        Click="OnCtxSubClick"
                                        ToolTip="本轮模型回应原文：思维链 + 答复正文 + 工具调用参数（data/rounds/会话/roundN-resp.json）"/>
                                <Button x:Name="ctxSubReq" DockPanel.Dock="Right" Content="请求上下文" Margin="0,0,2,0"
                                        Style="{StaticResource SkillViewBtn}" FontSize="11" Padding="9,2" Tag="cur"
                                        Click="OnCtxSubClick"
                                        ToolTip="本轮发给模型的完整上下文快照（data/rounds/会话/roundN.json）"/>
                                <TextBlock x:Name="ctxTitle" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <!-- 来源徽标（随子页换色换字：请求快照琥珀 / 回应快照青绿 / 无回应快照灰）+ 快照文件说明 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Border x:Name="ctxSrcTag" Background="#26F5B955" CornerRadius="4" Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ctxSrcText" FontSize="10" Foreground="#F5B955"/>
                                </Border>
                                <TextBlock x:Name="ctxRange" FontSize="10.5" Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 快照文本区：纯只读（复盘用途无编辑），行号 + 窄滚动条，与代码查看器同款观感 -->
                            <avalonEdit:TextEditor x:Name="ctxEdit" Grid.Row="2" Margin="0,8,0,0"
                                                   FontFamily="Consolas" FontSize="12"
                                                   ShowLineNumbers="True"
                                                   LineNumbersForeground="{StaticResource DimBrush}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Background="{StaticResource BgBrush}"
                                                   IsReadOnly="True"
                                                   VerticalScrollBarVisibility="Auto"
                                                   HorizontalScrollBarVisibility="Auto">
                                <avalonEdit:TextEditor.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource NarrowScroll}"/>
                                </avalonEdit:TextEditor.Resources>
                            </avalonEdit:TextEditor>
                        </Grid>

                        </Grid>
                    </DockPanel>
                </Border>
                <!-- 编排右栏拖把：独占中间列（orcSplitCol），GridSplitter 拖拽调整左列会话区/右列面板宽度。
                     拖把列 Auto 宽度随拖把 Visible/Collapsed 自动伸缩，面板收起时不留空列 -->
                <GridSplitter x:Name="orcSplit" Grid.Column="1" Width="6"
                              VerticalAlignment="Stretch" Margin="0,6,0,10" Visibility="Collapsed"
                              Cursor="SizeWE" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="Transparent" ToolTip="左右拖动调整编排面板宽度"
                              DragCompleted="OnOrcSplitDragCompleted">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border x:Name="gripLine" Width="1" Background="{StaticResource BorderBrush2}"
                                        HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="gripLine" Property="Background" Value="#8A9AC0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <!-- 轻量操作反馈浮层：3 秒自动消失、不占消息流；居中于会话区顶部，不拦截鼠标 -->
                <Border x:Name="toastTip" Grid.Column="0" Visibility="Collapsed" Opacity="1"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        Background="#F0242B45" BorderBrush="#FF3E4A6E" BorderThickness="1" CornerRadius="8"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="toastTipText" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                               Padding="16,8" MaxWidth="620" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 输入区（左右上 12px 与消息流统一；底部不再自带留白，改由下方双状态条自带 10px 下边距，
                 与左侧栏底部版权 gairr.com 行的下边距一致） -->
            <StackPanel Grid.Row="2" Margin="12,4,12,0">
                <Border x:Name="inputBorder" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="14" Padding="16,12" MouseDown="OnInputBorderClick">
                    <DockPanel>
                        <!-- 编排生成按钮（仅编排会话显示，声明于 DockPanel 首槽 → 恒居输入区最右）：交互式=「🎯 生成任务树」收口；multi=「🎯 生成方案」触发多模型决策。
                             左邻为 发送↔停止 同位互斥钮（发送在左、生成在右）：收集期空闲显示「发送」；运行/等待回复等 busy 态由「停止」在同位接管 -->
                        <Button x:Name="btnOrchGen" DockPanel.Dock="Right" Content="🎯 生成任务树"
                                Style="{StaticResource DarkActionBtn}"
                                Visibility="Collapsed" Click="OnOrchGenClick"
                                VerticalAlignment="Bottom" Height="38" Margin="8,0,10,5" Padding="16,0"
                                FontSize="13.5" FontWeight="Bold" Background="#26304E" Foreground="#E8ECF8"
                                ToolTip="信息收齐后点此生成编排方案（任务树）"/>
                        <!-- 发送右侧下拉箭头：普通会话入口（点击弹“打开新会话/转为编排会话”菜单）；可见性在代码中随发送钮同步，运行中/编排态一并隐藏 -->
                        <Button x:Name="sendMenuBtn" DockPanel.Dock="Right" Content="▾"
                                Style="{StaticResource DarkActionBtn}"
                                AutomationProperties.AutomationId="sendMenuBtn"
                                Click="OnSendMenuClick" VerticalAlignment="Bottom"
                                Height="38" Width="26" Margin="0,0,10,5" Padding="0"
                                FontSize="12" FontWeight="Bold" Background="#26304E" Foreground="#9AA6C8"
                                ToolTip="更多发送选项（打开新会话 / 转为编排会话）">
                            <Button.ContextMenu>
                                <ContextMenu Background="#1E1E28" BorderBrush="#333344">
                                    <MenuItem Header="发送完整上下文" Foreground="#DDDDE4"
                                              Click="OnSendFullContextClick"
                                              ToolTip="本条发送强制网页模型开新会话并整段投递完整上下文（非网页模型等同普通发送）"/>
                                    <Separator/>
                                    <MenuItem Header="打开新会话" Foreground="#DDDDE4"
                                              Click="OnOpenNewSessionClick"/>
                                    <Separator/>
                                    <MenuItem Header="转为编排会话" Foreground="#DDDDE4"
                                              Click="OnConvertToOrchClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- 发送（文字钮，位于最右“生成任务树”左侧；普通会话/编排收集期可点发消息，运行中隐藏并由同位“停止”接管） -->
                        <Button x:Name="sendBtn" DockPanel.Dock="Right" Content="发送"
                                Style="{StaticResource DarkActionBtn}"
                                AutomationProperties.AutomationId="sendBtn"
                                Click="OnSend" VerticalAlignment="Bottom"
                                Height="38" Margin="0,0,2,5" Padding="16,0"
                                FontSize="13.5" FontWeight="Bold" Background="#26304E" Foreground="#E8ECF8"/>
                        <Button x:Name="stopBtn" DockPanel.Dock="Right" Content="停止"
                                Style="{StaticResource DarkActionBtn}"
                                AutomationProperties.AutomationId="stopBtn"
                                Click="OnStop" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Height="38" Margin="0,0,2,5" Padding="16,0"
                                FontSize="13.5" FontWeight="Bold" Background="#26304E" Foreground="#E8ECF8"/>
                        <TextBox x:Name="inputBox" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.AutomationId="inputBox"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="44" MaxHeight="120" VerticalScrollBarVisibility="Hidden"
                                 Margin="0,0,12,0" VerticalAlignment="Bottom"
                                 PreviewKeyDown="OnInputKey" GotFocus="OnInputFocus" LostFocus="OnInputBlur"
                                 TextChanged="OnInputTextChanged"/>
                    </DockPanel>
                </Border>
                <!-- 澄清进度提示（编排收集期会话级汇总：还差几题未作答 → 全答后提醒提交 → 全部提交后提示可生成任务树；
                     非收集阶段/无卡会话隐藏，由 RefreshOrcQProgress 按状态着色） -->
                <TextBlock x:Name="orcQHint" Margin="4,6,0,0" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <!-- 双状态条：左侧后台运行日志（项目地图/LSP 服务器等，不参与会话），右侧大模型会话日志。
                     盒模型与左侧栏底部版权行（Margin=20,10,14,10、内容高 18、字号 12）逐项对齐：
                     外层 StackPanel 已给左右各 12，故此处左右补 8/2 合成 20/14；上下 10、定高 18、字号 12 与版权行同值 -->
                <DockPanel Margin="8,10,2,10" Height="18">
                    <TextBlock x:Name="bgStatus" DockPanel.Dock="Left" FontSize="12"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <TextBlock x:Name="logStatus" FontSize="12" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>

            <!-- 编辑窗（可开关，默认隐藏） -->
            <Border x:Name="editorPanel" Grid.Row="1" Grid.RowSpan="2"
                    Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed" Margin="0,0,0,0">
                <DockPanel>
                    <!-- 编辑窗标题栏 -->
                    <DockPanel DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Height="36">
                        <Button x:Name="editorClose" DockPanel.Dock="Right" Content="✕" Width="36" Height="36"
                                Style="{StaticResource CapBtn}" Click="OnEditorClose"/>
                        <Button x:Name="editorSave" DockPanel.Dock="Right" Content="💾" Width="36" Height="36"
                                Style="{StaticResource CapBtn}" Click="OnEditorSave" ToolTip="Ctrl+S 保存"/>
                        <TextBlock x:Name="editorTitle" Text="（未打开）" FontSize="12" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="12,0"/>
                    </DockPanel>
                    <!-- AvalonEdit 编辑器 -->
                    <avalonEdit:TextEditor x:Name="editor"
                                           Background="{StaticResource BgBrush}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Consolas" FontSize="13"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="{StaticResource DimBrush}"
                                           SyntaxHighlighting="C#"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ git 提交详情浮层：左树“项目跟踪”双击变更文件弹出，最大化铺于会话区/右栏上层（平时 Collapsed 不占布局，
             不影响会话中正在进行的任务）；仅露出左栏树便于继续双击切换 diff。头部=切换钮行（“提交详情”页签 + 查看磁盘文件 + ✕ 关闭右上角），
             下方=git 信息区（路径/徽标/commit）—分隔线—diff 行流（逐行旧/新文件行号；行文本可鼠标选中复制只读不改，
             右键行菜单可复制整段 diff）。与右栏编排面板解耦：编排会话查看 diff 不影响右侧编排内容；代码查看器与浮层互斥 ============ -->
        <Border x:Name="gitFloatPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                HorizontalAlignment="Left" VerticalAlignment="Top" Height="480"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="10" Padding="10,8,10,10" Visibility="Collapsed"
                PreviewMouseWheel="OnGitFloatWheel">
            <DockPanel>
                <!-- 切换钮行：左=当前页签“提交详情”（与右侧编排面板页签同款高亮，纯指示无切换动作）；右=查看磁盘文件与 ✕ 关闭（右上角） -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnGitDiffClose"
                            Style="{StaticResource CodeTabCloseBtn}"
                            FontSize="11" Padding="6,1"
                            Foreground="{StaticResource DimBrush}" ToolTip="关闭提交详情"/>
                    <Button x:Name="gitFileBtn" DockPanel.Dock="Right" Content="查看磁盘文件" Click="OnGitOpenFile"
                            Style="{StaticResource CodeTabCloseBtn}"
                            FontSize="10.5" Padding="6,1" Margin="0,0,8,0"
                            Foreground="{StaticResource DimBrush}" ToolTip="在资源管理器中定位到磁盘上的该文件"/>
                    <Border Background="#00000066" CornerRadius="8" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="提交详情" Style="{StaticResource SkillViewBtn}" Tag="cur"
                                    IsHitTestVisible="False" Focusable="False"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- git 信息区：标题=文件相对路径（超出省略） -->
                    <TextBlock x:Name="gitDiffTitle" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- git 信息区：状态徽标（新增/修改/删除）+ commit 归属信息 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                        <Border x:Name="gitDiffStat" Background="#26304E" CornerRadius="4" Padding="5,1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="gitDiffStatText" FontSize="10" Foreground="#8FC1FF"/>
                        </Border>
                        <TextBlock x:Name="gitDiffMeta" FontSize="10.5" Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- git 信息区与 diff 代码区之间的分隔线 -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,8,0,6"/>
                    <!-- diff 代码区：AvalonEdit 只读查看器——行文本可鼠标拖选多行 + Ctrl+C 复制（不支持修改），鼠标滚轮/滚动条上下滚动；
                         diff 行底色（+ 淡绿 / - 淡红）由代码侧 DiffBgRenderer 铺设，行号列由 DiffLineNumberMargin 自绘双列（旧|新）文件行号 -->
                    <avalonEdit:TextEditor x:Name="gitDiffEdit" Grid.Row="3"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           Background="{StaticResource BgBrush}"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="{StaticResource DimBrush}"
                                           IsReadOnly="True"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Auto">
                        <!-- 滚动条：窄深色（命中 TextEditor 内部 ScrollViewer；横向条同样压窄） -->
                        <avalonEdit:TextEditor.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate TargetType="RepeatButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand">
                                                            <RepeatButton.Template>
                                                                <ControlTemplate TargetType="RepeatButton">
                                                                    <Border Background="Transparent"/>
                                                                </ControlTemplate>
                                                            </RepeatButton.Template>
                                                        </RepeatButton>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border CornerRadius="2" Background="#2A2A3A"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="Width" Value="4"/>
                                    </Trigger>
                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="Height" Value="4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </avalonEdit:TextEditor.Resources>
                        <avalonEdit:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Click="OnGitDiffMenuCopy"/>
                                <MenuItem Header="全选" Click="OnGitDiffMenuSelectAll"/>
                                <Separator/>
                                <MenuItem Header="复制整个 diff" Click="OnGitDiffCopyAll"/>
                            </ContextMenu>
                        </avalonEdit:TextEditor.ContextMenu>
                    </avalonEdit:TextEditor>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>

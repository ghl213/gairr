<Window x:Class="GAIRR.WebModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="网页模型通道" Width="1160" Height="880" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#FF17171B"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD7D7DE"/>
            <Setter Property="Background" Value="#FF2C2C34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A3A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具条：站点标识 + 窗口级操作（重载 / 清登录态 / 隐藏） -->
        <Border Grid.Row="0" Background="#FF202027" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SiteTitle" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="#FFE6E6EA" FontSize="13" FontWeight="SemiBold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnHide" Content="隐藏到后台" Style="{StaticResource ToolBtn}" Click="OnHideClick"/>
                    <Button x:Name="BtnResetLogin" Content="清登录态" Style="{StaticResource ToolBtn}" Click="OnResetLoginClick"/>
                    <Button x:Name="BtnReload" Content="重载页面" Style="{StaticResource ToolBtn}" Click="OnReloadClick"/>
                    <Button x:Name="BtnDevTools" Content="开发者工具" Style="{StaticResource ToolBtn}" Click="OnDevToolsClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>

        <!-- 底部状态行：驱动过程与异常都会写到这里，便于排查站点改版 -->
        <Border Grid.Row="2" Background="#FF202027" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="#FF9AA0A6" FontSize="12"
                       TextTrimming="CharacterEllipsis" Text="正在初始化网页环境…"/>
        </Border>
    </Grid>
</Window>
